#!/usr/bin/env bash
#
# Auto-hydrate node_modules whenever a new git worktree is created, so parallel
# worktree agents get working dependencies without any of them needing npm
# egress. Installed as a system-wide core.hooksPath (see Dockerfile), so it
# covers every repo in the mounted workspace.
#
# post-checkout args: <prev-head> <new-head> <branch-checkout-flag>
# `git worktree add` runs a branch checkout whose prev-head is the null SHA
# (all zeros); ordinary branch switches pass a real prev-head. We act only on
# the null-SHA case, only inside a linked (non-main) worktree. wt-hydrate is
# itself idempotent, so re-runs are harmless.
prev="${1:-}"; flag="${3:-0}"

[ "$flag" = "1" ] || exit 0                  # 1 = branch checkout (worktree add qualifies)
case "$prev" in *[!0]*) exit 0 ;; esac       # any non-zero char => real prev HEAD => normal switch
[ -n "$prev" ] || exit 0                      # empty prev => not a worktree creation

common="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
gitdir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
[ "$common" != "$gitdir" ] || exit 0         # main worktree -> skip

command -v wt-hydrate >/dev/null 2>&1 && wt-hydrate "$PWD" || true
exit 0
