#!/usr/bin/env bash
#
# Auto-hydrate node_modules whenever a new git worktree is created, so parallel
# worktree agents get working dependencies without any of them needing npm
# egress. Installed as a system-wide core.hooksPath via GIT_CONFIG_SYSTEM
# (set per-run in csandbox's launch_bwrap, pointing at
# $CONFIG_DIR/bwrap-etc-gitconfig), so it covers every repo in the mounted
# workspace.
#
# post-checkout args: <prev-head> <new-head> <branch-checkout-flag>
# `git worktree add` runs a branch checkout whose prev-head is the null SHA
# (all zeros); ordinary branch switches pass a real prev-head. We act only on
# the null-SHA case, only inside a linked (non-main) worktree. wt-hydrate is
# itself idempotent, so re-runs are harmless.
prev="${1:-}"; flag="${3:-0}"

[ "$flag" = "1" ] || exit 0                  # 1 = branch checkout (worktree add qualifies)
case "$prev" in *[!0]*) exit 0 ;; esac       # any non-zero char => real prev HEAD => normal switch
[ -n "$prev" ] || exit 0                      # empty prev => not a worktree creation

common="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
gitdir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
[ "$common" != "$gitdir" ] || exit 0         # main worktree -> skip

# Record the worktree creation for csandbox to ingest on exit. The container
# can't write the tasks db (it lives outside the mount), so every worktree -
# top-level or subagent - is appended to this manifest in a mounted path;
# csandbox reads it host-side and registers the sessions. fork_sha is the commit
# the worktree branched from: it's the diff base and identifies the parent.
if [ -n "${CSANDBOX_MANIFEST:-}" ]; then
  printf '{"path":"%s","branch":"%s","fork_sha":"%s","created_at":%s}\n' \
    "$PWD" \
    "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" \
    "$(git rev-parse HEAD 2>/dev/null)" \
    "$(date +%s)" >> "$CSANDBOX_MANIFEST" 2>/dev/null || true
fi

command -v wt-hydrate >/dev/null 2>&1 && wt-hydrate "$PWD" || true

# Wire up declaratively-linked local deps (linker), isolated to this worktree.
# If the worktree root declares a links.json, replace its node_modules links
# with worktrees of each dep pinned to the sha in links.json, on THIS worktree's
# branch - so parallel sessions/subagents stay isolated. Runs after hydrate so
# it overwrites any stale symlinks the CoW clone brought over. Each dep worktree
# re-fires this hook, so the link graph is applied transitively; the reuse path
# (an existing worktree -> plain checkout, real prev-HEAD) stops any cycle.
# Network-quiet: the deps are all local under the mount with full history.
if [ -f "$PWD/links.json" ] && command -v linker >/dev/null 2>&1; then
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  linker load --worktree ${branch:+--branch "$branch"} >&2 \
    || echo "post-checkout: linker load failed (continuing)" >&2
fi
exit 0
