# a fresh container generates its own .claude.json (own machineID/userID)
# with hasCompletedOnboarding unset, which makes the interactive TUI show
# the first-run setup wizard (including a login step) despite valid
# credentials already being present. Force it past that gate every launch.
python3 - "$CONFIG_DIR/.claude.json" <<'EOF'
import json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        d = json.load(f)
except FileNotFoundError:
    d = {}
if not d.get('hasCompletedOnboarding'):
    d['hasCompletedOnboarding'] = True
    d.setdefault('lastOnboardingVersion', '0.0.0')
    with open(path, 'w') as f:
        json.dump(d, f)
EOF

# Zero-prompt setup. NOTE: this account has an org-managed remote setting
# (`disableBypassPermissionsMode: "disable"` in remote-settings.json, fetched
# from the server) that DISABLES bypassPermissions mode - so
# --dangerously-skip-permissions / defaultMode:bypassPermissions are refused
# and Claude falls back to `default` mode. We can't strip that policy from
# inside the sandbox (it rides the same api.anthropic.com connection Claude
# needs), so instead we make `default` mode prompt-free by allow-listing every
# state-changing tool. A bare tool-name allow rule (e.g. `Edit`, no parens)
# auto-approves ALL uses of that tool; `Bash(*)` additionally suppresses the
# built-in text-processing (awk/perl/sed) and shell-expansion heuristics.
# Each non-Bash tool needs its OWN rule - `Bash(*)` doesn't cover them - so the
# list below enumerates the local tools that would otherwise prompt (Monitor,
# WebSearch, Workflow, Skill, ...; subagents hit these too). Read-only tools
# (Read/Grep/Glob) never prompt; outward-publishing tools (Artifact,
# ShareOnboardingGuide) are left to prompt on purpose, and egress is governed
# by the proxy regardless.
# This is safe because the sandbox layer - not the permission engine - is the
# real boundary (non-root, network allowlisted, secrets shadowed). Residual
# prompts we CANNOT remove without true bypass mode:
#   - writes under protected dirs (.claude, .git, .vscode, ...) - hence the
#     scratch dir + CLAUDE.md steering the agent away from them
#   - rm -rf / and rm -rf ~ circuit breakers
python3 - "$CONFIG_DIR/settings.json" "$ROOT" "$SCRATCH_IN" <<'EOF'
import json, sys
path, root, scratch_in = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path) as f:
        d = json.load(f)
except FileNotFoundError:
    d = {}
perms = d.setdefault('permissions', {})
allow = perms.setdefault('allow', [])
for rule in ('Bash(*)', 'Edit', 'Write', 'WebFetch', 'WebSearch',
             'NotebookEdit', 'Monitor', 'Workflow', 'Skill'):
    if rule not in allow:
        allow.append(rule)
# By default Claude can only touch the dir it was launched in. The mount root
# is broader (e.g. all of ~/hyper for cross-repo links), so reading a sibling
# file inside the mount but outside the project dir would trigger the
# "outside working directory" trust prompt. Grant the whole mount root as an
# additional directory (file access only - no config side-loading, unlike
# --add-dir). Set to [root] + the scratch mount each launch. Scratch is a
# SEPARATE mount outside root where agents keep working copies (CLAUDE.md
# points them there, away from the protected .claude namespace), so it must
# be trusted too - otherwise every read/write under scratch triggers the
# trust prompt once bypass mode is unavailable (the org-policy case above).
perms['additionalDirectories'] = [root, scratch_in]
# EnterWorktree (called at session start per the "Top-level session worktree"
# CLAUDE.md guidance) branches from the current commit rather than the default
# branch. setdefault so this is only a seeded default - a user customization is
# left untouched.
d.setdefault('worktree', {}).setdefault('baseRef', 'head')
with open(path, 'w') as f:
    json.dump(d, f, indent=2)
EOF

# git identity for commits made inside the sandbox
if [ -f "$HOME/.gitconfig" ]; then
  add_mount ro "$HOME/.gitconfig" "$HOME_IN/.gitconfig"
fi

# --- linker: declarative local-dev linking ------------------------------
# linker wires a repo's node_modules to worktrees of its local deps, pinned by
# sha (links.json), applied per-worktree by the post-checkout hook. It's an
# unpublished host tool (detected above), so we mount it in rather than bake it
# into the image: its package dir at /opt/linker, a tiny wrapper on PATH, and
# the host registry (name->path). Host paths are valid in-container because the
# workspace mounts at the same path.
if [ -n "$LINKER_DIR" ]; then
  LINKER_WRAPPER="$LOCAL_SHARE_DIR/linker-wrapper"
  printf '#!/bin/sh\nexec node /opt/linker/cli.js "$@"\n' > "$LINKER_WRAPPER"
  chmod +x "$LINKER_WRAPPER"
  add_mount ro "$LINKER_DIR" /opt/linker
  add_mount ro "$LINKER_WRAPPER" "$BIN_IN/linker"
  [ -f "$HOME/.linker/registry.json" ] \
    && add_mount ro "$HOME/.linker/registry.json" "$HOME_IN/.linker/registry.json"
fi

# --- findings: external queryable memory (on by default; --no-findings) -----
# Same mount-not-bake approach as linker: the CLI at /opt/findings + a wrapper on
# PATH, plus a READ-WRITE ~/.findings store shared across sessions (the SQLite DB
# and the telemetry trace). FINDINGS_EVENTS logs a recall/record trace so miss-rate
# is measurable. Active whenever the tool was detected; --no-findings opts out.
FINDINGS_EVENTS=""
HOOKS_IN=""
if [ -n "$FINDINGS_DIR" ]; then
  FINDINGS_WRAPPER="$LOCAL_SHARE_DIR/findings-wrapper"
  printf '#!/bin/sh\nexec node /opt/findings/cli.js "$@"\n' > "$FINDINGS_WRAPPER"
  chmod +x "$FINDINGS_WRAPPER"
  # The store is ACCOUNT state - what one account's sessions learned must not
  # leak into another's - so it lives with the tenant: <config>/findings for a
  # named or explicit tenant (inside the config-dir mount, nothing extra to
  # bind), and the pre-existing ~/.findings for the default tenant (also the
  # host-side CLI's default, so `findings recall` on the host keeps working).
  # CSANDBOX_FINDINGS_HOME overrides - pointing two tenants at one dir is how
  # you share deliberately.
  if [ -n "${CSANDBOX_FINDINGS_HOME:-}" ]; then FINDINGS_HOME="$CSANDBOX_FINDINGS_HOME"
  elif [ "$DEFAULT_TENANT" = 1 ]; then FINDINGS_HOME="$HOME/.findings"
  else FINDINGS_HOME="$CONFIG_DIR/findings"; fi
  mkdir -p "$FINDINGS_HOME"
  add_mount ro "$FINDINGS_DIR" /opt/findings
  add_mount ro "$FINDINGS_WRAPPER" "$BIN_IN/findings"
  case "$FINDINGS_HOME" in
    "$CONFIG_DIR"/*) ;;                                    # already inside the config-dir mount
    *) add_mount rw "$FINDINGS_HOME" "$FINDINGS_HOME" ;;  # rw: store + telemetry trace (same path inside)
  esac
  FINDINGS_EVENTS="$FINDINGS_HOME/events.jsonl"
  # Hook scripts (claude-hooks/): copied to the host-side share dir and mounted
  # on PATH. Under bwrap they are reached at $BIN_IN/<name>; seatbelt applies no
  # mounts, so it runs them at their host path.
  #   memory-findings-nudge  PostToolUse(Edit|Write) - nudges the agent to also
  #                          findings-record its own auto-memory writes
  #   findings-hook prompt   UserPromptSubmit - auto-recall: injects the claims
  #                          matching the prompt (closes the "never recalls" gap)
  #   findings-hook stop     Stop - one-shot "record before you finish" nudge for
  #                          a substantial session that recorded nothing
  #   findings-hook compact  SessionStart(compact) - re-injects the claims shown
  #                          before compaction + a record nudge
  # Every findings script exits 0 silently unless FINDINGS_DB is set (only when
  # this block ran), so a stale registration can never break a --no-findings run.
fi
# All hook scripts are mounted regardless; registration below decides which
# are active. edit-gate (PreToolUse Edit|Write) is independent of findings: it
# blocks the FIRST edit to an existing source file once per session with a
# fact request (importers across the workspace, affected exports, formats) -
# see claude-hooks/edit-gate. OPT-IN via CSANDBOX_EDIT_GATE=1: with it on by
# default, agents were seen taking the refusal as "done" and moving on to run
# tests without the edit ever landing (2026-09-24), which is worse than the
# importer blind spot it guards against.
for _h in memory-findings-nudge findings-hook edit-gate; do
  cp "$SANDBOX_DIR/claude-hooks/$_h" "$LOCAL_SHARE_DIR/$_h"
  chmod +x "$LOCAL_SHARE_DIR/$_h"
  add_mount ro "$LOCAL_SHARE_DIR/$_h" "$BIN_IN/$_h"
done
if [ "$BACKEND" = seatbelt ]; then HOOKS_IN="$LOCAL_SHARE_DIR"; else HOOKS_IN="$BIN_IN"; fi

# Register (or, with findings inactive, remove) the findings hooks in the
# persistent settings.json. Idempotent by command string: this runs on every
# launch and settings.json persists across them, so a plain append would
# duplicate entries every session. Matching is on our own script names, so
# user-added hooks on the same events are left alone.
python3 - "$CONFIG_DIR/settings.json" "$HOOKS_IN" "${FINDINGS_DIR:+1}" "$EDIT_GATE" <<'EOF'
import json, sys
path, hooks_in, findings, edit_gate = sys.argv[1], sys.argv[2], sys.argv[3] == '1', sys.argv[4] == '1'
with open(path) as f:
    d = json.load(f)
OURS = ('memory-findings-nudge', 'findings-hook', 'edit-gate')
def is_ours(h):
    return any(('/' + n + ' ') in h.get('command', '') + ' ' for n in OURS)
hooks = d.setdefault('hooks', {})
# strip every previous registration of ours, then re-add the current set
for ev in list(hooks):
    kept = []
    for grp in hooks[ev]:
        rest = [h for h in grp.get('hooks', []) if not is_ours(h)]
        if rest:
            grp['hooks'] = rest
            kept.append(grp)
    if kept:
        hooks[ev] = kept
    else:
        del hooks[ev]
want = []
if findings:
    want += [
        ('PostToolUse',      'Edit|Write', f'{hooks_in}/memory-findings-nudge', None),
        ('UserPromptSubmit', None,         f'{hooks_in}/findings-hook prompt',  20),
        ('Stop',             None,         f'{hooks_in}/findings-hook stop',    15),
        ('SessionStart',     'compact',    f'{hooks_in}/findings-hook compact', 15),
    ]
if edit_gate:
    want += [('PreToolUse', 'Edit|Write', f'{hooks_in}/edit-gate', 10)]
if True:
    for ev, matcher, cmd, timeout in want:
        h = {'type': 'command', 'command': cmd}
        if timeout:
            h['timeout'] = timeout
        grp = {'hooks': [h]}
        if matcher:
            grp['matcher'] = matcher
        hooks.setdefault(ev, []).append(grp)
if not hooks:
    del d['hooks']
with open(path, 'w') as f:
    json.dump(d, f, indent=2)
EOF

# --- skills -------------------------------------------------------------
# Harness-level skills ship in this repo under skills/<name>/SKILL.md and are
# installed by COPY into the sandbox config dir, where Claude Code discovers
# them as user skills (`/name`, or the model loads them by description). Copy,
# not mount, so a skill edited on the host lands on the next launch and the
# agent can't write back into this repo. Only our names are replaced; anything
# else under skills/ (synced, user-added) is left alone. The findings skill is
# installed the same way when the tool is active.
mkdir -p "$CONFIG_DIR/skills"
for _s in "$SANDBOX_DIR"/skills/*/; do
  _n="$(basename "$_s")"
  rm -rf "$CONFIG_DIR/skills/$_n"
  cp -r "$_s" "$CONFIG_DIR/skills/$_n"
done
if [ -n "$FINDINGS_DIR" ] && [ -f "$FINDINGS_DIR/skills/findings.md" ]; then
  rm -rf "$CONFIG_DIR/skills/findings"; mkdir -p "$CONFIG_DIR/skills/findings"
  cp "$FINDINGS_DIR/skills/findings.md" "$CONFIG_DIR/skills/findings/SKILL.md"
else
  rm -rf "$CONFIG_DIR/skills/findings"
fi

# --- secret scrubbing -------------------------------------------------
# Shadow known secret-shaped files under the mounted root with an empty
# read-only file inside the sandbox. The host files are never touched -
# this only affects what the sandbox sees.
SECRET_PATTERNS=(
  '.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '*.keystore'
  'id_rsa' 'id_rsa.*' 'id_ed25519' 'id_ed25519.*' 'id_ecdsa' 'id_ecdsa.*'
  'credentials' 'credentials.json' '.npmrc' '.netrc' '.git-credentials'
  '.pypirc' 'service-account*.json'
)
FIND_NAME_ARGS=()
for i in "${!SECRET_PATTERNS[@]}"; do
  [ "$i" -gt 0 ] && FIND_NAME_ARGS+=(-o)
  FIND_NAME_ARGS+=(-name "${SECRET_PATTERNS[$i]}")
done

SCRUB_COUNT=0
SECRET_FILES=()   # captured for the seatbelt backend's denyRead (no /dev/null bind there)
while IFS= read -r -d '' f; do
  add_mount ro /dev/null "$f"
  SECRET_FILES+=("$f")
  SCRUB_COUNT=$((SCRUB_COUNT + 1))
done < <(find "$ROOT" \
  \( -path '*/node_modules/*' -o -path '*/.git/*' \) -prune -o \
  -type f \( "${FIND_NAME_ARGS[@]}" \) -print0 2>/dev/null)

# Well-known credential locations under $HOME. bwrap never exposes these (it only
# binds the workspace/config/scratch), but the seatbelt backend leaves the host
# filesystem visible by default, so they must be denied explicitly there.
HOME_SECRETS=(
  "$HOME/.ssh" "$HOME/.aws" "$HOME/.gnupg" "$HOME/.config/gcloud"
  "$HOME/.config/gh" "$HOME/.npmrc" "$HOME/.netrc" "$HOME/.docker/config.json"
  "$HOME/.kube/config" "$HOME/.git-credentials" "$HOME/.claude/.credentials.json"
)
# other tenants' logins (seatbelt leaves $HOME visible; bwrap never mounts them)
for _d in "$HOME"/.claude-sandbox "$HOME"/.claude-sandbox-*; do
  [ -d "$_d" ] && [ "$_d" != "$CONFIG_DIR" ] && HOME_SECRETS+=("$_d/.credentials.json" "$_d/oauth-token")
done

# --- egress allowlist ---------------------------------------------------
profile_domains() {
  case "$1" in
    minimal) ;;
    node)    echo "registry.npmjs.org registry.yarnpkg.com" ;;
    git)     echo "github.com codeload.github.com raw.githubusercontent.com objects.githubusercontent.com gist.githubusercontent.com" ;;
    python)  echo "pypi.org files.pythonhosted.org" ;;
    login)   echo "claude.ai" ;;   # the /login browser flow; only needed for a tenant's first run
    dev)     echo "$(profile_domains node) $(profile_domains git) $(profile_domains python)" ;;
    *)       echo "__UNKNOWN__:$1" ;;
  esac
}

# base: always present. api.anthropic.com is the inference API;
# platform.claude.com is the OAuth token-refresh endpoint - without it the
# seeded credentials die as soon as the access token expires (~hours).
DOMAIN_SET=("api.anthropic.com" "platform.claude.com")
IFS=',' read -ra PROFILES <<< "${CSANDBOX_PROFILE:-minimal}"
for p in "${PROFILES[@]}"; do
  p="$(echo "$p" | tr -d '[:space:]')"
  [ -z "$p" ] && continue
  for d in $(profile_domains "$p"); do
    if [[ "$d" == __UNKNOWN__:* ]]; then
      echo "error: unknown profile '${d#__UNKNOWN__:}' (valid: minimal node git python dev login)" >&2
      exit 1
    fi
    DOMAIN_SET+=("$d")
  done
done
if [ -n "${CSANDBOX_EXTRA_DOMAINS:-}" ]; then
  IFS=',' read -ra EXTRA <<< "$CSANDBOX_EXTRA_DOMAINS"
  for d in "${EXTRA[@]}"; do
    d="$(echo "$d" | tr -d '[:space:]')"
    [ -n "$d" ] && DOMAIN_SET+=("$d")
  done
fi
# dedupe, preserving order
ALLOWED_DOMAINS="$(printf '%s\n' "${DOMAIN_SET[@]}" | awk '!seen[$0]++' | paste -sd, -)"
export ALLOWED_DOMAINS

# --- workspace mount mode ------------------------------------------------
MOUNT_NOTE="read-write"
if [ "${CSANDBOX_READONLY:-}" = "1" ]; then
  add_mount ro "$ROOT" "$ROOT"
  MOUNT_NOTE="read-only"
else
  add_mount rw "$ROOT" "$ROOT"
fi

if [ "${CSANDBOX_SHELL:-}" = "1" ]; then
  CMD=(bash)
else
  # Default: the agent edits the checked-out tree directly (the seeded
  # "Top-level session worktree" block in CLAUDE.md says so). --worktree /
  # CSANDBOX_WORKTREE=1 flips it: a system-prompt directive tells the agent to
  # EnterWorktree at start and leave the branch for review.
  CLAUDE_ENV=(IS_SANDBOX=1 "DISABLE_AUTOUPDATER=1")
  [ -n "$CSANDBOX_MANIFEST" ] && CLAUDE_ENV+=("CSANDBOX_MANIFEST=$CSANDBOX_MANIFEST")
  CLAUDE_ENV+=("CSANDBOX_SCRATCH=$SCRATCH_IN")
  # bwrap injects CLAUDE_CONFIG_DIR via --setenv at launch; the seatbelt backend
  # runs claude with the plain env, so it must be set here or claude reads the
  # default ~/.claude instead of the sandbox config we populated.
  [ "$BACKEND" = seatbelt ] && CLAUDE_ENV+=("CLAUDE_CONFIG_DIR=$CONFIG_IN")
  # CSANDBOX_SESSION_ID + CSANDBOX_SNAPSHOT are inherited by subagents, so they
  # share this session's frozen snapshot and per-repo worktrees.
  [ -n "$CSANDBOX_SNAPSHOT" ] && CLAUDE_ENV+=("CSANDBOX_SNAPSHOT=$CSANDBOX_SNAPSHOT" "CSANDBOX_SESSION_ID=$SESSION_ID")
  # per-session state for hooks (edit-gate markers); under scratch so it is
  # agent-visible but harmless, and dies with the session dir
  CLAUDE_ENV+=("CSANDBOX_HOOK_STATE=$SCRATCH_IN/sessions/${SESSION_ID:-nosession}/hook-state" "CSANDBOX_EDIT_GATE=$EDIT_GATE" "CSANDBOX_ROOT=$ROOT")
  CLAUDE_ARGS=(--dangerously-skip-permissions)
  [ ${#MINT_SESSION_ARGS[@]} -gt 0 ] && CLAUDE_ARGS+=("${MINT_SESSION_ARGS[@]}")
  if [ "$LIVE" = 1 ]; then
    CLAUDE_ENV+=(CSANDBOX_LIVE=1)   # default; the seeded CLAUDE.md already says "work in the tree"
  else
    CLAUDE_ENV+=(CSANDBOX_WORKTREE=1)
    CLAUDE_ARGS+=(--append-system-prompt "This session was launched with csandbox --worktree: follow the WITH --worktree path of the 'Top-level session worktree' section in CLAUDE.md - check you are not already inside a .claude/worktrees path, otherwise call EnterWorktree before touching files, work on that disposable branch for the whole session, and leave it for the user to review (no push/PR/merge).")
  fi
  if [ -n "$FINDINGS_DIR" ]; then
    CLAUDE_ENV+=("FINDINGS_DB=$FINDINGS_HOME/findings.db" "FINDINGS_EVENTS=$FINDINGS_EVENTS")
    [ -n "$SESSION_ID" ] && CLAUDE_ENV+=("FINDINGS_SESSION=$SESSION_ID")
    # The guide lives at the mounted /opt path under bwrap, but at its real host
    # path under seatbelt (which doesn't relocate the filesystem).
    if [ "$BACKEND" = seatbelt ]; then FINDINGS_GUIDE="$FINDINGS_DIR/skills/findings.md"; else FINDINGS_GUIDE="/opt/findings/skills/findings.md"; fi
    # ephemeral (per-run) guidance - NOT written to the persistent CLAUDE.md, so
    # it never leaks into non --findings runs. Same mechanism as --live above.
    CLAUDE_ARGS+=(--append-system-prompt "An external 'findings' memory (a shared cross-session store) is available this session. Before investigating anything non-trivial, run 'findings recall <terms>' first - a past session may have already worked it out. When you learn something durable that isn't obvious from the code (a mechanism or gotcha, a decision and why, or a fact about the user/environment), record it with 'findings record'. Full usage guide: $FINDINGS_GUIDE. This is opt-in test tooling - use it alongside your normal workflow.")
  fi
  # bwrap routes egress through the loopback node proxy (nft-confined); seatbelt
  # uses Claude Code's built-in sandbox proxy instead, so no HTTP_PROXY here.
  if [ "$BACKEND" = bwrap ]; then
    CLAUDE_ENV+=("HTTP_PROXY=http://127.0.0.1:$PROXY_PORT" "HTTPS_PROXY=http://127.0.0.1:$PROXY_PORT" "NO_PROXY=localhost,127.0.0.1")
  fi
  # Host-side credentials outrank a tenant's stored login in Claude Code's
  # precedence (API key, bearer token, OAuth token, named profile), and bwrap
  # passes the host environment through - so strip them, then add the
  # tenant's own token if it has one.
  [ -n "$TENANT_TOKEN" ] && CLAUDE_ENV+=("CLAUDE_CODE_OAUTH_TOKEN=$TENANT_TOKEN")
  CMD=(env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_PROFILE
       "${CLAUDE_ENV[@]}" claude "${CLAUDE_ARGS[@]}" "$@")
fi

# --- launch -------------------------------------------------------------
echo "csandbox: backend $BACKEND, tenant '$TENANT_LABEL' -> $CONFIG_DIR (proxy :$PROXY_PORT)"
echo "csandbox: mount $ROOT ($MOUNT_NOTE), $SCRUB_COUNT secret file(s) shadowed"
echo "csandbox: egress allowlist -> $ALLOWED_DOMAINS"
[ -n "$LINKER_DIR" ] && echo "csandbox: linker -> $LINKER_DIR (declarative local links wired per-worktree)"
[ -n "$FINDINGS_DIR" ] && echo "csandbox: findings -> $FINDINGS_DIR (store $FINDINGS_HOME, telemetry on; --no-findings to disable)"
if [ "$LIVE" = 1 ]; then echo "csandbox: agent edits the working tree directly (--worktree for a disposable session branch)"; else echo "csandbox: --worktree -> agent works on a disposable session worktree"; fi

# dry run: show resolved config and stop before launching the backend
if [ "${CSANDBOX_DRYRUN:-}" = "1" ]; then
  echo "csandbox: workdir $PROJECT_DIR"
  if [ "$BACKEND" = seatbelt ]; then
    for f in "${HOME_SECRETS[@]}" ${SECRET_FILES[@]+"${SECRET_FILES[@]}"}; do
      [ -e "$f" ] && echo "csandbox: denyRead $f"
    done
  else
    for i in "${!MOUNT_SRC[@]}"; do
      echo "csandbox: mount (${MOUNT_MODE[$i]}) ${MOUNT_SRC[$i]} -> ${MOUNT_DST[$i]}"
    done
  fi
  echo "csandbox: (dry run, not launching)"
  exit 0
fi

RC=0
BLOCKED=""

launch_bwrap() {
  # host-side proxy lifecycle: reuse a running instance unless the resolved
  # allowlist changed, restarting it otherwise.
  local pidfile="$PROXY_PIDFILE"
  local domainsfile="$PROXY_DOMAINSFILE"
  local logfile="$PROXY_LOGFILE"
  local running=0
  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then running=1; fi
  if [ "$running" = 1 ] && [ "$(cat "$domainsfile" 2>/dev/null || true)" = "$ALLOWED_DOMAINS" ]; then
    : # reuse the already-running proxy
  else
    if [ "$running" = 1 ]; then kill "$(cat "$pidfile")" 2>/dev/null || true; fi
    (ALLOWED_DOMAINS="$ALLOWED_DOMAINS" PROXY_PORT="$PROXY_PORT" \
      setsid node "$SANDBOX_DIR/egress-proxy/proxy.js" >>"$logfile" 2>&1 &
      echo $! > "$pidfile")
    echo "$ALLOWED_DOMAINS" > "$domainsfile"
    sleep 0.3   # let it bind before the sandboxed process starts dialing out
    if ! kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      echo "csandbox: egress proxy failed to start on 127.0.0.1:$PROXY_PORT (port taken by another process? see $logfile)" >&2
      rm -f "$pidfile" "$domainsfile"; exit 1
    fi
  fi
  local proxy_log_start; proxy_log_start="$(wc -l < "$logfile" 2>/dev/null || echo 0)"

  # base system view: the real host toolchain, read-only; nothing else from
  # $HOME except the explicit mounts below (workspace/config/scratch/extras)
  local bw=(--unshare-user --unshare-pid --unshare-ipc --unshare-uts --unshare-cgroup --disable-userns --die-with-parent
            --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind-try /lib /lib
            --ro-bind-try /lib64 /lib64 --ro-bind-try /sbin /sbin
            --ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp)

  # node/npm + the claude CLI live under $HOME (nvm / ~/.local), not /usr -
  # bind just those, read-only (mount-not-bake, same spirit as linker/findings
  # above). This is what lets the bwrap path skip a build step entirely.
  local node_bin_dir; node_bin_dir="$(dirname "$(resolve "$(command -v node)")")"
  bw+=(--ro-bind "$node_bin_dir" "$node_bin_dir")
  bw+=(--ro-bind-try "$HOME/.local/bin" "$HOME/.local/bin")
  bw+=(--ro-bind-try "$HOME/.local/share/claude" "$HOME/.local/share/claude")

  # git-hooks: sets a system-wide `core.hooksPath` via GIT_CONFIG_SYSTEM (git
  # 2.32+) instead of writing into /etc - /etc is bound straight from the
  # real host read-only, and it's root-owned
  # there, so even a "rw" bind can't create a new /etc/gitconfig on top of it
  # (bind mount options don't override the underlying directory's real DAC
  # permissions). Pointing git at our own file entirely sidesteps that.
  local gitconfig="$CONFIG_DIR/bwrap-etc-gitconfig"
  printf '[core]\n\thooksPath = /opt/csandbox-tools/share/git-hooks\n' > "$gitconfig"
  bw+=(--setenv GIT_CONFIG_SYSTEM "$gitconfig")
  bw+=(--ro-bind "$SANDBOX_DIR/git-hooks" /opt/csandbox-tools/share/git-hooks)
  bw+=(--ro-bind "$SANDBOX_DIR/git-hooks/wt-hydrate" "$BIN_IN/wt-hydrate")
  bw+=(--ro-bind "$SANDBOX_DIR/git-hooks/csbox-enter-repo" "$BIN_IN/csbox-enter-repo")

  # everything else: workspace/config/scratch/linker/findings/secret-shadows
  local i
  for i in "${!MOUNT_SRC[@]}"; do
    if [ "${MOUNT_MODE[$i]}" = ro ]; then
      bw+=(--ro-bind "${MOUNT_SRC[$i]}" "${MOUNT_DST[$i]}")
    else
      bw+=(--bind "${MOUNT_SRC[$i]}" "${MOUNT_DST[$i]}")
    fi
  done

  bw+=(--chdir "$PROJECT_DIR")
  bw+=(--setenv PATH "$node_bin_dir:$HOME/.local/bin:$BIN_IN:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
  bw+=(--setenv HOME "$HOME")
  bw+=(--setenv CLAUDE_CONFIG_DIR "$CONFIG_IN")

  # Each run gets its own systemd --user transient scope under a fixed
  # "csandbox" slice; that slice is what the one-time nft rule (bwrap-setup)
  # restricts to the proxy's loopback port. No root/veth/slirp4netns needed -
  # the sandboxed process stays in the host's real network namespace, but
  # can't reach anything the nft rule doesn't allow.
  set +e
  systemd-run --user --scope --quiet --slice=csandbox \
    -p MemoryMax=16G -p TasksMax=8192 \
    --unit "csandbox-${SESSION_ID:-run}-$$" \
    -- bwrap "${bw[@]}" -- "${CMD[@]}"
  RC=$?
  set -e

  BLOCKED="$(tail -n "+$((proxy_log_start + 1))" "$logfile" 2>/dev/null \
    | grep -oE 'DENY [^:]+:' | sed 's/DENY //; s/:$//' | sort -u | paste -sd, - || true)"
}

launch_seatbelt() {
  # macOS backend. Rather than reproduce bwrap + an nft-confined proxy, we drive
  # Claude Code's OWN built-in OS sandbox (Seatbelt): it fences the filesystem
  # and forces Bash egress through a domain-allowlisted CONNECT proxy, enforced
  # by the OS for every Bash command and its children. We inject the policy into
  # the same settings.json the shared code above already generates.
  #
  # Two layers, both written here:
  #   sandbox.*            - governs BASH commands + children (fs scope + egress)
  #   permissions.deny     - Read() rules so Claude's OWN Read/Grep tools (which
  #                          run unsandboxed) also can't read the secret list
  #
  # Strict is mandatory, not cosmetic: allowUnsandboxedCommands=false. With
  # Bash(*) allowed (added by the shared settings patch to kill prompts), a
  # command hitting a non-allowed domain would otherwise fall back to the
  # permission flow and be auto-approved UNSANDBOXED - escaping the egress
  # boundary. Strict mode makes such a command fail instead.
  python3 - "$CONFIG_DIR/settings.json" "$ROOT" "$SCRATCH_IN" "$MOUNT_NOTE" \
      "$ALLOWED_DOMAINS" \
      "$(printf '%s\n' "${HOME_SECRETS[@]}" ${SECRET_FILES[@]+"${SECRET_FILES[@]}"})" <<'PY'
import json, os, sys
path, root, scratch, mode, domains_csv, secrets_raw = sys.argv[1:7]

with open(path) as f:
    d = json.load(f)

domains = [x for x in domains_csv.split(',') if x]
secrets = [s for s in secrets_raw.splitlines() if s.strip()]

fs = {}
if mode == "read-only":
    fs["allowWrite"] = [scratch]      # scratch stays writable (summaries/handoffs)
    fs["denyWrite"] = [root]
else:
    fs["allowWrite"] = [root, scratch]
if secrets:
    fs["denyRead"] = secrets

d["sandbox"] = {
    "enabled": True,
    "autoAllowBashIfSandboxed": True,
    "allowUnsandboxedCommands": False,   # strict: no unsandboxed escape (see above)
    "network": {"allowedDomains": domains},
    "filesystem": fs,
}

# Second layer: mirror the secret denyRead as Read() deny rules for Claude's own
# tools. Claude rule syntax: "~/x" for home, "//abs" for an absolute path; emit
# an exact rule AND a recursive one per path so it covers files and dirs alike.
home = os.path.expanduser("~")
def rule_paths(p):
    base = ("~" + p[len(home):]) if (p == home or p.startswith(home + os.sep)) else ("/" + p.lstrip("/"))
    return [base, base.rstrip("/") + "/**"]
deny = sorted({"Read(%s)" % rp for s in secrets for rp in rule_paths(s)})
perms = d.setdefault("permissions", {})
existing = set(perms.get("deny", []))
perms["deny"] = sorted(existing | set(deny))

with open(path, "w") as f:
    json.dump(d, f, indent=2)
PY

  # No external proxy, no bwrap, no systemd slice: the sandbox is applied by
  # claude itself from the settings above. Just run it in the project dir.
  # (Resource caps like bwrap's MemoryMax/TasksMax have no Seatbelt equivalent.)
  set +e
  ( cd "$PROJECT_DIR" && exec "${CMD[@]}" )
  RC=$?
  set -e
}

case "$BACKEND" in
  bwrap)    launch_bwrap ;;
  seatbelt) launch_seatbelt ;;
esac

if [ -n "$BLOCKED" ]; then
  echo "csandbox: blocked egress this session -> $BLOCKED"
  echo "csandbox: to allow, re-run with --allow $BLOCKED (or a --profile)"
fi

exit $RC
