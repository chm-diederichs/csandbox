#!/usr/bin/env bash
#
# csandbox [project-dir] [claude args...]
#
# Default launcher for running Claude Code inside a hardened, image-less, daemon-
# less sandbox. Two backends, chosen by OS (override with CSANDBOX_BACKEND):
#   Linux -> bwrap    native namespaces (bubblewrap) + an nft-confined egress
#                     proxy. One-time root setup first: `sudo ./bwrap-setup`.
#   macOS -> seatbelt Claude Code's own built-in OS sandbox (Seatbelt) - filesystem
#                     scoping + a domain-allowlisted egress proxy, no root/setup.
# The workflow layer (worktrees, linker, findings + its hooks, CLAUDE.md
# seeding) and the egress-allowlist model below are shared across both.
#
# The sandboxed process stays in the host's normal network namespace, but is
# launched into a dedicated systemd/cgroup slice that a one-time nft rule
# (installed by bwrap-setup) restricts to the egress-proxy's loopback port
# only - so the only route out is through the proxy's domain allowlist below.
#
#   - runs as the non-root/unprivileged user, no added capabilities
#   - known secret-shaped files under the mounted root are shadowed with an
#     empty read-only file inside the sandbox (host files are untouched)
#
# EGRESS ALLOWLIST
#   The allowlist is built from three layers, unioned and deduped:
#     1. base        - api.anthropic.com + platform.claude.com (always;
#                      inference + OAuth token refresh) plus the domains of
#                      the selected profile(s)
#     2. CSANDBOX_PROFILE - one or more comma-separated profiles (default:
#                      "minimal"). Available profiles:
#                        minimal - (nothing beyond the base)
#                        node    - registry.npmjs.org, registry.yarnpkg.com
#                        git     - github.com, codeload.github.com,
#                                  raw.githubusercontent.com,
#                                  objects.githubusercontent.com,
#                                  gist.githubusercontent.com
#                        python  - pypi.org, files.pythonhosted.org
#                        dev     - node + git + python (general coding)
#     3. CSANDBOX_EXTRA_DOMAINS - comma-separated one-off additions
#
#   The default is intentionally minimal: api.anthropic.com only. That host
#   is single-tenant Anthropic space (not a shared CDN), so it is not a
#   domain-fronting substrate. npm/github/pypi live on shared CDNs
#   (Cloudflare/Fastly) which a hostname-only proxy cannot front-proof, so
#   they are opt-in per workflow rather than always-on.
#
#   The resolved allowlist is printed at launch, and any hosts blocked
#   during the session are reported on exit so you know what to add.
#
# Examples:
#   csandbox                                     # sandbox cwd, minimal egress
#   csandbox ~/code/myapp
#   csandbox . --continue                        # unknown args go to claude
#   csandbox --profile dev .                     # allow npm + git + pypi
#   csandbox --profile node,git --allow example.com .   # combine profiles, one-off host
#   csandbox --readonly .                        # mount workspace read-only
#   csandbox --shell .                           # drop into bash, not claude
#   csandbox --worktree .                        # agent works on a disposable branch (default: edits the tree directly)
#   csandbox --tenant work .                     # a second Claude account: own config dir, login, proxy port, findings
#   csandbox --dry-run .                         # print resolved config & exit
#   csandbox down [--tenant work]                # stop that tenant's egress proxy & exit
#   csandbox --help
#
# Convention: per-invocation choices are FLAGS; every flag has an environment
# variable as its default (CSANDBOX_PROFILE, CSANDBOX_TENANT, ...), so a shell
# profile can pin a preference. Machine configuration is environment-only:
# CSANDBOX_BACKEND, CSANDBOX_FINDINGS_DIR (tool location), CSANDBOX_FINDINGS_HOME
# (store override). --root is remembered per tenant (<config>/root). Flags are parsed anywhere
# in the argument list and shadow same-named claude flags (--worktree); claude's
# short forms (-w) still pass through.

set -euo pipefail

# macOS ships bash 3.2 (frozen for GPLv3 reasons), where empty-array expansion
# under `set -u` errors; we target bash >= 4. Fail fast with the fix rather than
# crashing mid-run on an "unbound variable".
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "csandbox: needs bash >= 4 (macOS ships 3.2 - run 'brew install bash')" >&2
  exit 1
fi

# Portable across Linux + macOS: macOS lacks `readlink -f` (older releases) and
# /proc, so avoid both. Follow a symlink chain by hand and mint uuids from
# whatever is available.
resolve() {
  local p="$1" t
  while [ -L "$p" ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(cd "$(dirname "$p")" && pwd)/$t" ;; esac
  done
  printf '%s\n' "$p"
}
gen_uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then uuidgen | tr '[:upper:]' '[:lower:]'
  else python3 -c 'import uuid; print(uuid.uuid4())'
  fi
}

SANDBOX_DIR="$(cd "$(dirname "$(resolve "${BASH_SOURCE[0]}")")" && pwd)"

# bwrap has no image to define a fake home in, so it mounts everything at its
# real host path instead. HOME_IN/BIN_IN are used throughout below so the
# config/scratch/linker/findings mounts are only written once.
HOME_IN="$HOME"
# /usr is a read-only bind of the actual host /usr, so a NEW file can't be
# created under it (the underlying directory is root-owned - a "rw" bind
# doesn't change real DAC permissions). /opt is never bound from the host at
# all, so we can freely create a fresh tree there instead for wrapper
# binaries (linker/findings/git-hooks).
BIN_IN="/opt/csandbox-tools/bin"

# --- backend selection + preflight -------------------------------------------
# Two isolation backends, picked by OS (override with CSANDBOX_BACKEND):
#   bwrap    - Linux native namespaces + an nft-confined egress proxy (default
#              on Linux; needs the one-time `sudo bwrap-setup`).
#   seatbelt - macOS, via Claude Code's OWN built-in OS sandbox (Seatbelt): it
#              provides filesystem scoping AND a domain-allowlisted egress proxy
#              with no external daemon, no root setup, and no image. See
#              launch_seatbelt below. The workflow layer (session db, worktrees,
#              linker, findings, CLAUDE.md seeding) is shared with bwrap.
BACKEND="${CSANDBOX_BACKEND:-}"
if [ -z "$BACKEND" ]; then
  case "$(uname -s)" in
    Linux)  BACKEND=bwrap ;;
    Darwin) BACKEND=seatbelt ;;
    *) echo "csandbox: unsupported OS '$(uname -s)' (need Linux or macOS)" >&2; exit 1 ;;
  esac
fi

# Fails fast, before any of the setup work below, if a backend prerequisite is
# missing - never invoked automatically from here.
bwrap_preflight() {
  command -v bwrap >/dev/null 2>&1 || { echo "csandbox: bwrap (bubblewrap) not installed - apt install bubblewrap" >&2; exit 1; }
  command -v systemd-run >/dev/null 2>&1 || { echo "csandbox: systemd-run not found - csandbox needs a systemd user session" >&2; exit 1; }
  if [ ! -f /etc/apparmor.d/bwrap-csandbox ]; then
    echo "csandbox: one-time setup not done yet - run: sudo $SANDBOX_DIR/bwrap-setup" >&2
    exit 1
  fi
}
seatbelt_preflight() {
  [ "$(uname -s)" = "Darwin" ] || { echo "csandbox: the seatbelt backend is macOS-only" >&2; exit 1; }
  command -v claude >/dev/null 2>&1 || { echo "csandbox: 'claude' not found on PATH" >&2; exit 1; }
}
case "$BACKEND" in
  bwrap)    bwrap_preflight ;;
  seatbelt) seatbelt_preflight ;;
  *) echo "csandbox: unknown CSANDBOX_BACKEND='$BACKEND' (valid: bwrap seatbelt)" >&2; exit 1 ;;
esac

# --- mount list ---------------------------------------------------------
# Every mount csandbox wants - workspace, config, scratch, linker/findings,
# secret shadows, git-hooks - is recorded here once and translated to
# `--ro-bind`/`--bind` args at launch time.
MOUNT_MODE=(); MOUNT_SRC=(); MOUNT_DST=()
add_mount() { MOUNT_MODE+=("$1"); MOUNT_SRC+=("$2"); MOUNT_DST+=("$3"); }  # add_mount <ro|rw> <src> <dst>

usage() {
  cat <<'EOF'
usage: csandbox [flags] [project-dir] [claude args...]
       csandbox down [--tenant <name>]        stop that tenant's egress proxy

Unknown arguments pass through to `claude`. Every flag has an environment
variable default (in brackets); the variable is what hooks and subprocesses see.

  --tenant <name>        second Claude account: config dir ~/.claude-sandbox-<name>,
                         own login, proxy port and findings store   [CSANDBOX_TENANT]
  --config-dir <dir>     explicit config dir (wins over --tenant)    [CSANDBOX_CONFIG_DIR]
  --proxy-port <n>       this tenant's egress proxy port             [CSANDBOX_PROXY_PORT]
  --profile <p[,p]>      egress profile(s): minimal|node|git|python|dev|login  [CSANDBOX_PROFILE]
  --allow <host[,host]>  extra allowed hosts, repeatable             [CSANDBOX_EXTRA_DOMAINS]
  --root <dir>           workspace root to mount; remembered per tenant in
                         <config>/root (delete the file to forget)   [CSANDBOX_ROOT]
  --readonly             mount the workspace read-only               [CSANDBOX_READONLY=1]
  --worktree             agent works on a disposable session worktree
                         (default: edits the checked-out tree)       [CSANDBOX_WORKTREE=1]
  --live                 the default; kept for muscle memory
  --findings / --no-findings   cross-session findings memory (default on)  [CSANDBOX_FINDINGS=0]
  --edit-gate            opt-in first-edit fact gate hook            [CSANDBOX_EDIT_GATE=1]
  --shell                drop into bash inside the sandbox           [CSANDBOX_SHELL=1]
  --dry-run              print the resolved config and exit          [CSANDBOX_DRYRUN=1]
  -h, --help             this text (only as the first argument; later it goes to claude)

environment-only (machine configuration):
  CSANDBOX_BACKEND       bwrap | seatbelt (default by OS)
  CSANDBOX_FINDINGS_DIR  where the findings tool lives (default: PATH, then ~/dev/findings)
  CSANDBOX_FINDINGS_HOME findings store override (default: ~/.findings for the default
                         tenant, <config>/findings for a named one)
EOF
}
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# Pull csandbox's own flags out of the arg list; everything else goes to claude.
# A flag just exports the environment variable it stands for, so the rest of
# the script (and every hook/subprocess) keeps reading one source of truth.
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    down|--down)     export CSANDBOX_DOWN=1; shift ;;
    --tenant)        export CSANDBOX_TENANT="${2:-}"; shift 2 2>/dev/null || shift ;;
    --config-dir)    export CSANDBOX_CONFIG_DIR="${2:-}"; shift 2 2>/dev/null || shift ;;
    --proxy-port)    export CSANDBOX_PROXY_PORT="${2:-}"; shift 2 2>/dev/null || shift ;;
    --profile)       export CSANDBOX_PROFILE="${2:-}"; shift 2 2>/dev/null || shift ;;
    --allow)         export CSANDBOX_EXTRA_DOMAINS="${CSANDBOX_EXTRA_DOMAINS:+$CSANDBOX_EXTRA_DOMAINS,}${2:-}"; shift 2 2>/dev/null || shift ;;
    --root)          export CSANDBOX_ROOT="${2:-}" CSANDBOX_ROOT_SAVE=1; shift 2 2>/dev/null || shift ;;
    --readonly)      export CSANDBOX_READONLY=1; shift ;;
    --worktree)      export CSANDBOX_WORKTREE=1; shift ;;
    --live)          export CSANDBOX_WORKTREE=0; shift ;;
    --findings)      export CSANDBOX_FINDINGS=1 CSANDBOX_FINDINGS_EXPLICIT=1; shift ;;
    --no-findings)   export CSANDBOX_FINDINGS=0; shift ;;
    --edit-gate)     export CSANDBOX_EDIT_GATE=1; shift ;;
    --shell)         export CSANDBOX_SHELL=1; shift ;;
    --dry-run)       export CSANDBOX_DRYRUN=1; shift ;;
    *)               ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

LIVE=1                                 # default: agent edits the checked-out tree
[ "${CSANDBOX_WORKTREE:-0}" = 1 ] && LIVE=0
FINDINGS="${CSANDBOX_FINDINGS:-1}"     # external memory: on by default
FINDINGS_EXPLICIT="${CSANDBOX_FINDINGS_EXPLICIT:-0}"   # warn about a missing tool only when asked for explicitly
TENANT="${CSANDBOX_TENANT:-}"
EDIT_GATE="${CSANDBOX_EDIT_GATE:-0}"   # OPT-IN PreToolUse fact-forcing gate on first edits (claude-hooks/edit-gate). Off by default: agents were observed treating the refusal as done and moving on without the edit

# --- tenant: which Claude account this run belongs to -------------------------
# A tenant is a Claude Code config dir (CLAUDE_CONFIG_DIR). Claude Code keeps
# every account-shaped thing under that dir - the OAuth login, .claude.json
# (account/org ids), settings, sessions, the cached server-managed org policy -
# and under bwrap the host ~/.claude isn't even mounted, so tenants can't see
# each other. Everything else (workspace, slice + nft rule, wrapper scripts,
# the findings store) is per USER and shared.
#   --tenant <name> / CSANDBOX_TENANT=<name>   -> ~/.claude-sandbox-<name>
#   CSANDBOX_CONFIG_DIR=<dir>                   -> that dir (wins over --tenant)
#   neither                                     -> ~/.claude-sandbox (the default tenant)
if [ -n "${CSANDBOX_CONFIG_DIR:-}" ]; then CONFIG_DIR="$CSANDBOX_CONFIG_DIR"
elif [ -n "$TENANT" ]; then CONFIG_DIR="$HOME/.claude-sandbox-$TENANT"
else CONFIG_DIR="$HOME/.claude-sandbox"; fi
mkdir -p "$CONFIG_DIR"
DEFAULT_TENANT=0; [ "$CONFIG_DIR" = "$HOME/.claude-sandbox" ] && DEFAULT_TENANT=1
TENANT_LABEL="${TENANT:-$([ "$DEFAULT_TENANT" = 1 ] && echo default || echo custom)}"

# A tenant can be scoped to a workspace root: `--root <dir>` is remembered in
# <config>/root and applies to every later run of that tenant (a tenant for a
# client's code stays inside that tree). Precedence: --root > CSANDBOX_ROOT in
# the environment > the remembered root > the ~/hyper heuristic below. Delete
# the file to forget. With a root in effect and no project dir given, a run
# started outside the root lands at the root instead of failing.
ROOT_FILE="$CONFIG_DIR/root"
if [ "${CSANDBOX_ROOT_SAVE:-0}" = 1 ]; then
  [ -d "$CSANDBOX_ROOT" ] || { echo "csandbox: --root $CSANDBOX_ROOT is not a directory" >&2; exit 1; }
  CSANDBOX_ROOT="$(cd "$CSANDBOX_ROOT" && pwd -P)"; export CSANDBOX_ROOT
  printf '%s\n' "$CSANDBOX_ROOT" > "$ROOT_FILE"
elif [ -z "${CSANDBOX_ROOT:-}" ] && [ -s "$ROOT_FILE" ]; then
  CSANDBOX_ROOT="$(head -n1 "$ROOT_FILE")"; export CSANDBOX_ROOT
  [ -d "$CSANDBOX_ROOT" ] || { echo "csandbox: tenant '$TENANT_LABEL' remembers root $CSANDBOX_ROOT but it no longer exists - fix it with --root <dir> or delete $ROOT_FILE" >&2; exit 1; }
fi

# Host-side share dir: per user, OUTSIDE every config dir so no sandboxed agent
# can see or mutate it. Wrapper scripts, hook copies and per-port proxy state.
LOCAL_SHARE_DIR="$HOME/.local/share/csandbox"
mkdir -p "$LOCAL_SHARE_DIR"

# Every tenant runs its OWN egress proxy on its own loopback port: one shared
# proxy would carry whichever tenant's allowlist restarted it last. The nft rule
# (bwrap-setup) opens a small port RANGE for the slice and records it in
# /etc/csandbox/proxy-ports ("MIN MAX"); the default tenant is MIN (8888), a
# named tenant takes CSANDBOX_PROXY_PORT if set, else the lowest port in the
# range no other ~/.claude-sandbox-* tenant has claimed, remembered in
# <config>/proxy-port. (A CSANDBOX_CONFIG_DIR outside that naming isn't seen by
# the scan - give it CSANDBOX_PROXY_PORT explicitly.)
PORT_RANGE_FILE="${CSANDBOX_PORT_RANGE_FILE:-/etc/csandbox/proxy-ports}"
PORT_MIN=8888; PORT_MAX=8888
[ -f "$PORT_RANGE_FILE" ] && read -r PORT_MIN PORT_MAX < "$PORT_RANGE_FILE"
if [ -n "${CSANDBOX_PROXY_PORT:-}" ]; then PROXY_PORT="$CSANDBOX_PROXY_PORT"
elif [ "$DEFAULT_TENANT" = 1 ]; then PROXY_PORT="$PORT_MIN"
elif [ -f "$CONFIG_DIR/proxy-port" ]; then PROXY_PORT="$(cat "$CONFIG_DIR/proxy-port")"
else
  _used=" $PORT_MIN "
  for _f in "$HOME"/.claude-sandbox-*/proxy-port; do [ -f "$_f" ] && _used="$_used$(cat "$_f") "; done
  PROXY_PORT=""; _p=$((PORT_MIN + 1))
  while [ "$_p" -le "$PORT_MAX" ]; do
    case "$_used" in *" $_p "*) ;; *) PROXY_PORT="$_p"; break ;; esac
    _p=$((_p + 1))
  done
  if [ -z "$PROXY_PORT" ]; then
    if [ ! -f "$PORT_RANGE_FILE" ]; then
      echo "csandbox: tenant '$TENANT_LABEL' needs its own proxy port, but this bwrap-setup predates multi-tenant ports - re-run it once: sudo $SANDBOX_DIR/bwrap-setup" >&2
    else
      echo "csandbox: no free proxy port left in $PORT_MIN-$PORT_MAX for tenant '$TENANT_LABEL' (widen it: sudo CSANDBOX_PROXY_PORTS=8888-8919 $SANDBOX_DIR/bwrap-setup)" >&2
    fi
    exit 1
  fi
  echo "$PROXY_PORT" > "$CONFIG_DIR/proxy-port"
fi
# The nft rule only lets the slice reach ports in the recorded range; a port
# outside it would be silently dropped, so refuse up front.
if [ "$BACKEND" = bwrap ] && { [ "$PROXY_PORT" -lt "$PORT_MIN" ] || [ "$PROXY_PORT" -gt "$PORT_MAX" ]; }; then
  echo "csandbox: proxy port $PROXY_PORT is outside the range the nft rule allows ($PORT_MIN-$PORT_MAX)." >&2
  if [ ! -f "$PORT_RANGE_FILE" ]; then echo "csandbox: this bwrap-setup predates multi-tenant ports - re-run it once: sudo $SANDBOX_DIR/bwrap-setup" >&2; fi
  exit 1
fi
PROXY_PIDFILE="$LOCAL_SHARE_DIR/proxy-$PROXY_PORT.pid"
PROXY_DOMAINSFILE="$LOCAL_SHARE_DIR/proxy-$PROXY_PORT.domains"
PROXY_LOGFILE="$LOCAL_SHARE_DIR/proxy-$PROXY_PORT.log"

# pre-tenant layouts kept proxy state in the config dir; adopt it so an already
# running proxy is reused rather than a second one racing for the same port
if [ -f "$CONFIG_DIR/bwrap-proxy.pid" ]; then
  mv -f "$CONFIG_DIR/bwrap-proxy.pid" "$PROXY_PIDFILE"
  [ -f "$CONFIG_DIR/bwrap-proxy.domains" ] && mv -f "$CONFIG_DIR/bwrap-proxy.domains" "$PROXY_DOMAINSFILE"
  [ -f "$CONFIG_DIR/bwrap-proxy.log" ] && cat "$CONFIG_DIR/bwrap-proxy.log" >> "$PROXY_LOGFILE" && rm -f "$CONFIG_DIR/bwrap-proxy.log"
fi

# teardown shortcut: stop THIS tenant's proxy
if [ "${CSANDBOX_DOWN:-}" = "1" ]; then
  if [ -f "$PROXY_PIDFILE" ] && kill -0 "$(cat "$PROXY_PIDFILE")" 2>/dev/null; then
    kill "$(cat "$PROXY_PIDFILE")" 2>/dev/null || true
    echo "csandbox: stopped the egress proxy for tenant '$TENANT_LABEL' (port $PROXY_PORT, pid $(cat "$PROXY_PIDFILE"))"
  else
    echo "csandbox: no egress proxy running for tenant '$TENANT_LABEL' (port $PROXY_PORT)"
  fi
  rm -f "$PROXY_PIDFILE" "$PROXY_DOMAINSFILE"
  exit 0
fi

# first arg is the project dir if it's a directory, otherwise default to cwd
if [ $# -gt 0 ] && [ -d "$1" ]; then
  PROJECT_DIR="$(cd "$1" && pwd -P)"
  shift
else
  PROJECT_DIR="$PWD"
  # no project dir given and cwd is outside the root in effect: start at the root
  if [ -n "${CSANDBOX_ROOT:-}" ]; then
    _root="$(cd "$CSANDBOX_ROOT" && pwd -P)"
    case "$PROJECT_DIR" in "$_root" | "$_root"/*) ;; *) PROJECT_DIR="$_root" ;; esac
  fi
fi

# workspace root: explicit override > ~/hyper (if the project is inside it,
# so cross-repo npm links resolve) > the project dir itself
if [ -n "${CSANDBOX_ROOT:-}" ]; then
  ROOT="$(cd "$CSANDBOX_ROOT" && pwd -P)"
elif [[ "$PROJECT_DIR" == "$HOME/hyper/"* ]]; then
  ROOT="$HOME/hyper"
else
  ROOT="$PROJECT_DIR"
fi

case "$PROJECT_DIR" in
  "$ROOT" | "$ROOT"/*) ;;
  *)
    echo "error: project dir $PROJECT_DIR is not inside workspace root $ROOT" >&2
    exit 1
    ;;
esac

# --- session identity -----------------------------------------------------
# Every run is recorded in the tasks db (see the recorder in the post-run
# block). We need this run's claude session id: reuse a pinned (--session-id)
# or resumed (--resume <id> / -r <id>) one; leave it empty for --continue or
# the bare --resume picker (the recorder discovers it after exit); otherwise
# mint a uuid and pin it - which also makes plain standalone runs resumable.
SESSION_ID=""
MINT_SESSION_ARGS=()
_prev=""; _has_session_flag=0
for a in "$@"; do
  case "$a" in
    --session-id|--resume|-r|--continue|-c) _has_session_flag=1 ;;
  esac
  case "$_prev" in
    --session-id|--resume|-r) case "$a" in -*) ;; *) SESSION_ID="$a" ;; esac ;;
  esac
  _prev="$a"
done
if [ -z "$SESSION_ID" ] && [ "$_has_session_flag" = 0 ] && [ "${CSANDBOX_SHELL:-}" != "1" ]; then
  SESSION_ID="$(gen_uuid)"
  MINT_SESSION_ARGS=(--session-id "$SESSION_ID")
fi

# Persistent scratch space for the agent. Writes under a .claude/ dir always
# trigger Claude Code's hardcoded self-config guard (even with skip-
# permissions + Bash(*)), so agents get a dedicated dir outside that
# namespace - pointed at it via the global CLAUDE.md seeded below and the
# $CSANDBOX_SCRATCH env var.
SCRATCH_DIR="$CONFIG_DIR/scratch"
mkdir -p "$SCRATCH_DIR"
# bwrap mounts everything at its own real host path, so these are reused as-is.
SCRATCH_IN="$SCRATCH_DIR"
CONFIG_IN="$CONFIG_DIR"
add_mount rw "$CONFIG_DIR" "$CONFIG_IN"
add_mount rw "$SCRATCH_DIR" "$SCRATCH_IN"

CSANDBOX_MANIFEST=""
CSANDBOX_SNAPSHOT=""
# Set only when the session id is known up front (fresh mint, or
# --resume/--session-id); a --continue/picker run has no id yet.
if [ -n "$SESSION_ID" ]; then
  mkdir -p "$SCRATCH_DIR/sessions/$SESSION_ID"
  # every worktree created this session (top-level or subagent) is appended here
  # by the post-checkout hook - path/branch/fork_sha, one line per worktree -
  # since the sandboxed process can't write host-side state directly.
  CSANDBOX_MANIFEST="$SCRATCH_IN/sessions/$SESSION_ID/worktrees.jsonl"
  # Freeze every repo state under ROOT at spawn (branch + sha). Agents work off
  # this snapshot so concurrent host-side checkouts/commits can't disturb a
  # running session; csbox-enter-repo worktrees a repo pinned to its snapshot,
  # and subagents inherit it via the env var. ~150ms over ~/hyper (parallel).
  CSANDBOX_SNAPSHOT="$SCRATCH_IN/sessions/$SESSION_ID/snapshot.json"
  python3 - "$ROOT" "$SCRATCH_DIR/sessions/$SESSION_ID/snapshot.json" <<'PY' 2>/dev/null || true
import glob, json, os, subprocess, sys
from concurrent.futures import ThreadPoolExecutor
root, out = sys.argv[1], sys.argv[2]
repos = [os.path.dirname(g) for g in glob.glob(os.path.join(root, '*', '.git'))]
def snap(r):
    try:
        b = subprocess.check_output(['git', '-C', r, 'rev-parse', '--abbrev-ref', 'HEAD'],
                                    stderr=subprocess.DEVNULL).decode().strip()
        s = subprocess.check_output(['git', '-C', r, 'rev-parse', 'HEAD'],
                                    stderr=subprocess.DEVNULL).decode().strip()
        return (r, {'branch': b, 'sha': s}) if s else None
    except Exception:
        return None
with ThreadPoolExecutor(max_workers=8) as ex:
    d = dict(x for x in ex.map(snap, repos) if x)
json.dump(d, open(out, 'w'))
PY
fi

# Detect the host linker (mounted in further down). Resolved here so the CLAUDE.md
# guidance below is only seeded when linked-dep support is actually active.
LINKER_DIR=""
LINKER_CLI="$(command -v linker 2>/dev/null || true)"
if [ -n "$LINKER_CLI" ]; then
  _ld="$(dirname "$(resolve "$LINKER_CLI")")"
  [ -f "$_ld/cli.js" ] && LINKER_DIR="$_ld"
fi

# Detect the host findings tool (external queryable memory; ON BY DEFAULT,
# --no-findings to disable). Like linker, an unpublished host tool mounted in
# rather than baked into the image. If it isn't installed we silently skip
# (findings just isn't active that run) unless the user explicitly asked.
FINDINGS_DIR=""
if [ "$FINDINGS" = 1 ]; then
  _fcli="$(command -v findings 2>/dev/null || true)"
  if [ -n "$_fcli" ]; then
    _fd="$(dirname "$(resolve "$_fcli")")"
    [ -f "$_fd/cli.js" ] && FINDINGS_DIR="$_fd"
  fi
  _fdefault="${CSANDBOX_FINDINGS_DIR:-$HOME/dev/findings}"
  [ -z "$FINDINGS_DIR" ] && [ -f "$_fdefault/cli.js" ] && FINDINGS_DIR="$_fdefault"
  [ -z "$FINDINGS_DIR" ] && [ "$FINDINGS_EXPLICIT" = 1 ] && echo "csandbox: --findings set but the findings tool wasn't found (npm link it, or set CSANDBOX_FINDINGS_DIR)" >&2
fi

if [ ! -f "$CONFIG_DIR/CLAUDE.md" ] || ! grep -q '^# Scratch directory$' "$CONFIG_DIR/CLAUDE.md"; then
