#!/usr/bin/env bash
#
# csandbox [project-dir] [claude args...]
#
# Default launcher for running Claude Code with --dangerously-skip-permissions
# inside a hardened Docker Compose sandbox:
#   - the sandbox container has NO direct route to the internet; all egress
#     must pass through the `proxy` sidecar, which only allows connections to
#     an explicit domain allowlist (everything else gets a 403)
#   - runs as the non-root `node` user (uid 1000), no added capabilities
#   - the docker socket is never mounted
#   - known secret-shaped files under the mounted root are shadowed with an
#     empty read-only file inside the container (host files are untouched)
#
# EGRESS ALLOWLIST
#   The allowlist is built from three layers, unioned and deduped:
#     1. base        - api.anthropic.com + platform.claude.com (always;
#                      inference + OAuth token refresh) plus the domains of
#                      the selected profile(s)
#     2. CSANDBOX_PROFILE - one or more comma-separated profiles (default:
#                      "minimal"). Available profiles:
#                        minimal - (nothing beyond the base)
#                        node    - registry.npmjs.org, registry.yarnpkg.com
#                        git     - github.com, codeload.github.com,
#                                  raw.githubusercontent.com,
#                                  objects.githubusercontent.com,
#                                  gist.githubusercontent.com
#                        python  - pypi.org, files.pythonhosted.org
#                        dev     - node + git + python (general coding)
#     3. CSANDBOX_EXTRA_DOMAINS - comma-separated one-off additions
#
#   The default is intentionally minimal: api.anthropic.com only. That host
#   is single-tenant Anthropic space (not a shared CDN), so it is not a
#   domain-fronting substrate. npm/github/pypi live on shared CDNs
#   (Cloudflare/Fastly) which a hostname-only proxy cannot front-proof, so
#   they are opt-in per workflow rather than always-on.
#
#   The resolved allowlist is printed at launch, and any hosts blocked
#   during the session are reported on exit so you know what to add.
#
# Examples:
#   csandbox                                     # sandbox cwd, minimal egress
#   csandbox ~/code/myapp
#   csandbox . --continue                        # extra args go to claude
#   CSANDBOX_PROFILE=dev csandbox .              # allow npm + git + pypi
#   CSANDBOX_PROFILE=node,git csandbox .         # combine profiles
#   CSANDBOX_EXTRA_DOMAINS=example.com csandbox . # one-off host
#   CSANDBOX_ROOT=~/src csandbox .               # custom workspace root
#   CSANDBOX_READONLY=1 csandbox .               # mount workspace read-only
#   CSANDBOX_SHELL=1 csandbox .                  # drop into bash, not claude
#   csandbox --live .                            # edit the working tree directly (no worktree)
#   CSANDBOX_DRYRUN=1 csandbox .                 # print resolved config & exit
#   CSANDBOX_DOWN=1 csandbox                     # stop the proxy sidecar & exit

set -euo pipefail

# --- portability shims (Linux + macOS) ------------------------------------
# The container internals stay Linux; this is only the HOST-side launcher, which
# must also run on a macOS host. macOS lacks `readlink -f` (older releases) and
# `/proc`, so avoid both here.
resolve () {  # portable `readlink -f`: follow a symlink chain by hand
  local p="$1" t
  while [ -L "$p" ]; do
    t="$(readlink "$p")"                                  # no -f: one level, works on both
    case "$t" in /*) p="$t" ;; *) p="$(cd "$(dirname "$p")" && pwd)/$t" ;; esac
  done
  printf '%s\n' "$p"
}
gen_uuid () {  # /proc is Linux-only; uuidgen is on both (macOS upper-cases it)
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  elif command -v uuidgen >/dev/null 2>&1; then uuidgen | tr '[:upper:]' '[:lower:]'
  else python3 -c 'import uuid; print(uuid.uuid4())'
  fi
}

SANDBOX_DIR="$(cd "$(dirname "$(resolve "${BASH_SOURCE[0]}")")" && pwd)"
COMPOSE_FILE="$SANDBOX_DIR/docker-compose.yml"
COMPOSE_PROJECT=claude-sandbox
compose() { docker compose -f "$COMPOSE_FILE" -p "$COMPOSE_PROJECT" "$@"; }

# teardown shortcut
if [ "${CSANDBOX_DOWN:-}" = "1" ]; then
  compose down
  exit 0
fi

# pull csandbox's own flags out of the arg list; everything else goes to claude
LIVE=0
NAME=""
FINDINGS="${CSANDBOX_FINDINGS:-1}"   # external memory: on by default; --no-findings / CSANDBOX_FINDINGS=0 disables
FINDINGS_EXPLICIT=0                    # set by --findings; warn only then if the tool is missing
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --live) LIVE=1; shift ;;
    --findings) FINDINGS=1; FINDINGS_EXPLICIT=1; shift ;;   # explicit on (already the default)
    --no-findings) FINDINGS=0; shift ;;                     # opt out of the findings memory
    --name) NAME="${2:-}"; shift 2 2>/dev/null || shift ;;   # human label for the review UI
    *)      ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# first arg is the project dir if it's a directory, otherwise default to cwd
if [ $# -gt 0 ] && [ -d "$1" ]; then
  PROJECT_DIR="$(cd "$1" && pwd -P)"
  shift
else
  PROJECT_DIR="$PWD"
fi

# workspace root: explicit override > ~/hyper (if the project is inside it,
# so cross-repo npm links resolve) > the project dir itself
if [ -n "${CSANDBOX_ROOT:-}" ]; then
  ROOT="$(cd "$CSANDBOX_ROOT" && pwd -P)"
elif [[ "$PROJECT_DIR" == "$HOME/hyper/"* ]]; then
  ROOT="$HOME/hyper"
else
  ROOT="$PROJECT_DIR"
fi

case "$PROJECT_DIR" in
  "$ROOT" | "$ROOT"/*) ;;
  *)
    echo "error: project dir $PROJECT_DIR is not inside workspace root $ROOT" >&2
    exit 1
    ;;
esac

# --- session identity -----------------------------------------------------
# Every run is recorded in the tasks db (see the recorder in the post-run
# block). We need this run's claude session id: reuse a pinned (--session-id)
# or resumed (--resume <id> / -r <id>) one; leave it empty for --continue or
# the bare --resume picker (the recorder discovers it after exit); otherwise
# mint a uuid and pin it - which also makes plain standalone runs resumable.
SESSION_ID=""
MINT_SESSION_ARGS=()
_prev=""; _has_session_flag=0
for a in "$@"; do
  case "$a" in
    --session-id|--resume|-r|--continue|-c) _has_session_flag=1 ;;
  esac
  case "$_prev" in
    --session-id|--resume|-r) case "$a" in -*) ;; *) SESSION_ID="$a" ;; esac ;;
  esac
  _prev="$a"
done
if [ -z "$SESSION_ID" ] && [ "$_has_session_flag" = 0 ] && [ "${CSANDBOX_SHELL:-}" != "1" ]; then
  SESSION_ID="$(gen_uuid)"
  MINT_SESSION_ARGS=(--session-id "$SESSION_ID")
fi

CONFIG_DIR="$HOME/.claude-sandbox"
mkdir -p "$CONFIG_DIR"

# tasks db: host-side, and OUTSIDE the bind-mounted config dir so the sandboxed
# agent can't see or mutate it. csandbox records one row per run here on exit;
# the review UI reads it. Override the path with CSANDBOX_TASKS_DB.
TASKS_DB="${CSANDBOX_TASKS_DB:-$HOME/.local/share/csandbox/tasks.db}"
mkdir -p "$(dirname "$TASKS_DB")"

# Persistent scratch space for the agent, mounted at /home/node/scratch.
# Writes under a .claude/ dir always trigger Claude Code's hardcoded
# self-config guard (even with skip-permissions + Bash(*)), so agents get a
# dedicated dir outside that namespace - pointed at it via the global
# CLAUDE.md seeded below.
SCRATCH_DIR="$CONFIG_DIR/scratch"
mkdir -p "$SCRATCH_DIR"

# Per-session summary artifact (docs/agent-contract.md): the agent writes its
# review summary to $CSANDBOX_SUMMARY. It lives under scratch - agent-writable,
# not committed, survives exit - namespaced by session id. Set only when the id
# is known up front (fresh mint, or --resume/--session-id); a --continue/picker
# run has no id yet, so it gets no summary path.
CSANDBOX_SUMMARY=""
CSANDBOX_MANIFEST=""
CSANDBOX_SNAPSHOT=""
CSANDBOX_COMMENTS=""
if [ -n "$SESSION_ID" ]; then
  mkdir -p "$SCRATCH_DIR/sessions/$SESSION_ID"
  CSANDBOX_SUMMARY="/home/node/scratch/sessions/$SESSION_ID/summary.md"
  # every worktree created this session (top-level or subagent) is appended here
  # by the post-checkout hook; csandbox ingests it on exit to register sessions
  # (the container can't write the tasks db, which lives outside the mount).
  CSANDBOX_MANIFEST="/home/node/scratch/sessions/$SESSION_ID/worktrees.jsonl"
  # Freeze every repo state under ROOT at spawn (branch + sha). Agents work off
  # this snapshot so concurrent host-side checkouts/commits can't disturb a
  # running session; csbox-enter-repo worktrees a repo pinned to its snapshot,
  # and subagents inherit it via the env var. ~150ms over ~/hyper (parallel).
  CSANDBOX_SNAPSHOT="/home/node/scratch/sessions/$SESSION_ID/snapshot.json"
  # append-only review-comment log (docs/review-loop.md): reviewers (human via
  # csreview, or an agent via the review skill) append comment/resolved/compiled
  # events; one log per session, keyed {repo,branch}. Inherited by subagents.
  CSANDBOX_COMMENTS="/home/node/scratch/sessions/$SESSION_ID/comments.jsonl"
  python3 - "$ROOT" "$SCRATCH_DIR/sessions/$SESSION_ID/snapshot.json" <<'PY' 2>/dev/null || true
import glob, json, os, subprocess, sys
from concurrent.futures import ThreadPoolExecutor
root, out = sys.argv[1], sys.argv[2]
repos = [os.path.dirname(g) for g in glob.glob(os.path.join(root, '*', '.git'))]
def snap(r):
    try:
        b = subprocess.check_output(['git', '-C', r, 'rev-parse', '--abbrev-ref', 'HEAD'],
                                    stderr=subprocess.DEVNULL).decode().strip()
        s = subprocess.check_output(['git', '-C', r, 'rev-parse', 'HEAD'],
                                    stderr=subprocess.DEVNULL).decode().strip()
        return (r, {'branch': b, 'sha': s}) if s else None
    except Exception:
        return None
with ThreadPoolExecutor(max_workers=8) as ex:
    d = dict(x for x in ex.map(snap, repos) if x)
json.dump(d, open(out, 'w'))
PY
fi

# Detect the host linker (mounted in further down). Resolved here so the CLAUDE.md
# guidance below is only seeded when linked-dep support is actually active.
LINKER_DIR=""
LINKER_CLI="$(command -v linker 2>/dev/null || true)"
if [ -n "$LINKER_CLI" ]; then
  _ld="$(dirname "$(resolve "$LINKER_CLI")")"
  [ -f "$_ld/cli.js" ] && LINKER_DIR="$_ld"
fi

# Detect the host findings tool (external queryable memory; ON BY DEFAULT,
# --no-findings to disable). Like linker, an unpublished host tool mounted in
# rather than baked into the image. If it isn't installed we silently skip
# (findings just isn't active that run) unless the user explicitly asked.
FINDINGS_DIR=""
if [ "$FINDINGS" = 1 ]; then
  _fcli="$(command -v findings 2>/dev/null || true)"
  if [ -n "$_fcli" ]; then
    _fd="$(dirname "$(resolve "$_fcli")")"
    [ -f "$_fd/cli.js" ] && FINDINGS_DIR="$_fd"
  fi
  _fdefault="${CSANDBOX_FINDINGS_DIR:-$HOME/dev/findings}"
  [ -z "$FINDINGS_DIR" ] && [ -f "$_fdefault/cli.js" ] && FINDINGS_DIR="$_fdefault"
  [ -z "$FINDINGS_DIR" ] && [ "$FINDINGS_EXPLICIT" = 1 ] && echo "csandbox: --findings set but the findings tool wasn't found (npm link it, or set CSANDBOX_FINDINGS_DIR)" >&2
fi

if [ ! -f "$CONFIG_DIR/CLAUDE.md" ] || ! grep -q '/home/node/scratch' "$CONFIG_DIR/CLAUDE.md"; then
  cat >> "$CONFIG_DIR/CLAUDE.md" <<'EOF'

# Scratch directory
Use `/home/node/scratch/` for your own working files (notes, plans, temp
scripts, intermediate results). Do NOT create or write into `.claude/`
directories inside projects - writes there trigger approval prompts.
EOF
fi
if ! grep -q 'Top-level session worktree' "$CONFIG_DIR/CLAUDE.md" 2>/dev/null; then
  cat >> "$CONFIG_DIR/CLAUDE.md" <<'EOF'

# Top-level session worktree
At the start of every session in a git repo, call `EnterWorktree` before
touching any files, so my own edits land on a disposable branch instead of
the user's checked-out working tree - the user is often hacking there
concurrently and needs it left alone. `worktree.baseRef` is set to `head`,
so the worktree branches from the current commit (not origin/default) -
but note this only carries committed history, not the user's
uncommitted/staged changes, since worktrees can't share those. When the
work is done, leave the branch as-is (`ExitWorktree` with `action: "keep"`)
and tell the user it's ready to review and merge manually - don't push,
open a PR, or merge it myself unless asked.
EOF
fi
if ! grep -q 'Parallel worktree subagents' "$CONFIG_DIR/CLAUDE.md" 2>/dev/null; then
  cat >> "$CONFIG_DIR/CLAUDE.md" <<'EOF'

# Parallel worktree subagents
When a task parallelizes, fan out with `Agent(isolation: "worktree")` - each
subagent gets its own worktree, all in this one container. This nests fine
under the top-level session's own worktree. node_modules is hydrated
automatically when the worktree is created, so don't run `npm install` or
treat the worktree as having no deps. Keep the parallel phase network-quiet:
adding a NEW dependency needs the npm registry and will trip the egress gate, so
do dependency changes before/after fanning out, not during. Use /home/node/scratch
for handoffs between agents.
EOF
fi
if ! grep -q 'Session output' "$CONFIG_DIR/CLAUDE.md" 2>/dev/null; then
  cat >> "$CONFIG_DIR/CLAUDE.md" <<'EOF'

# Session output
Produce what the reviewer will look at (see docs/agent-contract.md):
- COMMIT your work on the worktree branch before finishing - a commit is what
  creates a reviewable diff; uncommitted changes are invisible to branch review.
- ALWAYS write a short summary to the file named in the `$CSANDBOX_SUMMARY`
  environment variable (run `echo "$CSANDBOX_SUMMARY"` to get the path), even if
  you committed nothing (got stuck, or were only fact-finding). Use the headings:
  `## Summary`, `## Changes`, `## Open questions / needs attention`, `## Blocked on`.
- Do NOT put review feedback in inline code comments - it pollutes the diff.
  Session-level notes go in the summary; line-level comments come back from the
  human via the review tool.
EOF
fi
if ! grep -q 'Crossing repos' "$CONFIG_DIR/CLAUDE.md" 2>/dev/null; then
  cat >> "$CONFIG_DIR/CLAUDE.md" <<'EOF'

# Crossing repos
To work in a DIFFERENT repo under the workspace than the one you started in, do
NOT just cd into it - run `csbox-enter-repo <repo>` (a path or a bare repo name)
and work in the path it prints. That worktrees the repo pinned to this session's
frozen snapshot, so your view stays consistent with spawn time and isolated from
any host-side checkouts or commits since. Subagents share the same per-repo
worktree automatically.
EOF
fi
if [ -n "$LINKER_DIR" ] && ! grep -q 'Linked local dependencies' "$CONFIG_DIR/CLAUDE.md" 2>/dev/null; then
  cat >> "$CONFIG_DIR/CLAUDE.md" <<'EOF'

# Linked local dependencies
If a repo has a `links.json`, its local-dependency links are wired up
AUTOMATICALLY when its worktree is created (`linker load`, run by the same hook
that hydrates node_modules): each linked dep becomes a worktree pinned to the
sha in links.json, isolated to this worktree's branch, and symlinked into
node_modules. So do NOT run `npm link` or hand-symlink local deps - it's already
done and isolated. To add or re-pin a link, edit the dep and run `linker pin` in
the repo (updates links.json, which you then commit). Run `linker check` to
flag any stray node_modules symlink that isn't declared in links.json.
EOF
fi

# The sandbox has its own login (token chain lives in ~/.claude-sandbox),
# rather than a copy of the host credentials: OAuth refresh tokens rotate,
# so a seeded copy dies as soon as the host client refreshes. First run:
#   CSANDBOX_EXTRA_DOMAINS=claude.ai csandbox .   # then /login inside
if [ ! -f "$CONFIG_DIR/.credentials.json" ]; then
  echo "csandbox: no sandbox login yet - run /login inside (needs claude.ai allowed):"
  echo "csandbox:   CSANDBOX_EXTRA_DOMAINS=claude.ai csandbox ."
fi

# a fresh container generates its own .claude.json (own machineID/userID)
# with hasCompletedOnboarding unset, which makes the interactive TUI show
# the first-run setup wizard (including a login step) despite valid
# credentials already being present. Force it past that gate every launch.
python3 - "$CONFIG_DIR/.claude.json" <<'EOF'
import json, sys
path = sys.argv[1]
try:
    with open(path) as f:
        d = json.load(f)
except FileNotFoundError:
    d = {}
if not d.get('hasCompletedOnboarding'):
    d['hasCompletedOnboarding'] = True
    d.setdefault('lastOnboardingVersion', '0.0.0')
    with open(path, 'w') as f:
        json.dump(d, f)
EOF

# Zero-prompt setup. NOTE: this account has an org-managed remote setting
# (`disableBypassPermissionsMode: "disable"` in remote-settings.json, fetched
# from the server) that DISABLES bypassPermissions mode - so
# --dangerously-skip-permissions / defaultMode:bypassPermissions are refused
# and Claude falls back to `default` mode. We can't strip that policy from
# inside the sandbox (it rides the same api.anthropic.com connection Claude
# needs), so instead we make `default` mode prompt-free by allow-listing every
# state-changing tool. A bare tool-name allow rule (e.g. `Edit`, no parens)
# auto-approves ALL uses of that tool; `Bash(*)` additionally suppresses the
# built-in text-processing (awk/perl/sed) and shell-expansion heuristics.
# Each non-Bash tool needs its OWN rule - `Bash(*)` doesn't cover them - so the
# list below enumerates the local tools that would otherwise prompt (Monitor,
# WebSearch, Workflow, Skill, ...; subagents hit these too). Read-only tools
# (Read/Grep/Glob) never prompt; outward-publishing tools (Artifact,
# ShareOnboardingGuide) are left to prompt on purpose, and egress is governed
# by the proxy regardless.
# This is safe because the Docker layer - not the permission engine - is the
# real boundary (non-root, no docker socket, network allowlisted, secrets
# shadowed). Residual prompts we CANNOT remove without true bypass mode:
#   - writes under protected dirs (.claude, .git, .vscode, ...) - hence the
#     scratch dir + CLAUDE.md steering the agent away from them
#   - rm -rf / and rm -rf ~ circuit breakers
python3 - "$CONFIG_DIR/settings.json" "$ROOT" <<'EOF'
import json, sys
path, root = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        d = json.load(f)
except FileNotFoundError:
    d = {}
perms = d.setdefault('permissions', {})
allow = perms.setdefault('allow', [])
for rule in ('Bash(*)', 'Edit', 'Write', 'WebFetch', 'WebSearch',
             'NotebookEdit', 'Monitor', 'Workflow', 'Skill'):
    if rule not in allow:
        allow.append(rule)
# By default Claude can only touch the dir it was launched in. The mount root
# is broader (e.g. all of ~/hyper for cross-repo links), so reading a sibling
# file inside the mount but outside the project dir would trigger the
# "outside working directory" trust prompt. Grant the whole mount root as an
# additional directory (file access only - no config side-loading, unlike
# --add-dir). Set to [root] + the scratch mount each launch. Scratch
# (/home/node/scratch) is a SEPARATE mount outside root where agents keep working
# copies (CLAUDE.md points them there, away from the protected .claude namespace),
# so it must be trusted too — otherwise every read/write under scratch triggers
# the trust prompt once bypass mode is unavailable (the org-policy case above).
perms['additionalDirectories'] = [root, '/home/node/scratch']
# EnterWorktree (called at session start per the "Top-level session worktree"
# CLAUDE.md guidance) branches from the current commit rather than the default
# branch. setdefault so this is only a seeded default - a user customization is
# left untouched.
d.setdefault('worktree', {}).setdefault('baseRef', 'head')
with open(path, 'w') as f:
    json.dump(d, f, indent=2)
EOF

# git identity for commits made inside the sandbox
EXTRA_MOUNTS=()
if [ -f "$HOME/.gitconfig" ]; then
  EXTRA_MOUNTS+=(-v "$HOME/.gitconfig:/home/node/.gitconfig:ro")
fi

# --- linker: declarative local-dev linking ------------------------------
# linker wires a repo's node_modules to worktrees of its local deps, pinned by
# sha (links.json), applied per-worktree by the post-checkout hook. It's an
# unpublished host tool (detected above), so we mount it in rather than bake it
# into the image: its package dir at /opt/linker, a tiny wrapper on PATH, and
# the host registry (name->path). Host paths are valid in-container because the
# workspace mounts at the same path.
if [ -n "$LINKER_DIR" ]; then
  LINKER_WRAPPER="$(dirname "$TASKS_DB")/linker-wrapper"
  printf '#!/bin/sh\nexec node /opt/linker/cli.js "$@"\n' > "$LINKER_WRAPPER"
  chmod +x "$LINKER_WRAPPER"
  EXTRA_MOUNTS+=(-v "$LINKER_DIR:/opt/linker:ro" -v "$LINKER_WRAPPER:/usr/local/bin/linker:ro")
  [ -f "$HOME/.linker/registry.json" ] \
    && EXTRA_MOUNTS+=(-v "$HOME/.linker/registry.json:/home/node/.linker/registry.json:ro")
fi

# --- findings: external queryable memory (on by default; --no-findings) -----
# Same mount-not-bake approach as linker: the CLI at /opt/findings + a wrapper on
# PATH, plus a READ-WRITE ~/.findings store shared across sessions (the SQLite DB
# and the telemetry trace). FINDINGS_EVENTS logs a recall/record trace so miss-rate
# is measurable. Active whenever the tool was detected; --no-findings opts out.
FINDINGS_EVENTS=""
if [ -n "$FINDINGS_DIR" ]; then
  FINDINGS_WRAPPER="$(dirname "$TASKS_DB")/findings-wrapper"
  printf '#!/bin/sh\nexec node /opt/findings/cli.js "$@"\n' > "$FINDINGS_WRAPPER"
  chmod +x "$FINDINGS_WRAPPER"
  mkdir -p "$HOME/.findings"
  EXTRA_MOUNTS+=(-v "$FINDINGS_DIR:/opt/findings:ro" -v "$FINDINGS_WRAPPER:/usr/local/bin/findings:ro")
  EXTRA_MOUNTS+=(-v "$HOME/.findings:/home/node/.findings")   # rw: shared store + telemetry trace
  FINDINGS_EVENTS="/home/node/.findings/events.jsonl"
fi

# --- secret scrubbing -------------------------------------------------
# Shadow known secret-shaped files under the mounted root with an empty
# read-only file inside the container. The host files are never touched -
# this only affects what the container sees.
SECRET_PATTERNS=(
  '.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '*.keystore'
  'id_rsa' 'id_rsa.*' 'id_ed25519' 'id_ed25519.*' 'id_ecdsa' 'id_ecdsa.*'
  'credentials' 'credentials.json' '.npmrc' '.netrc' '.git-credentials'
  '.pypirc' 'service-account*.json'
)
FIND_NAME_ARGS=()
for i in "${!SECRET_PATTERNS[@]}"; do
  [ "$i" -gt 0 ] && FIND_NAME_ARGS+=(-o)
  FIND_NAME_ARGS+=(-name "${SECRET_PATTERNS[$i]}")
done

SCRUB_COUNT=0
while IFS= read -r -d '' f; do
  EXTRA_MOUNTS+=(-v "/dev/null:$f:ro")
  SCRUB_COUNT=$((SCRUB_COUNT + 1))
done < <(find "$ROOT" \
  \( -path '*/node_modules/*' -o -path '*/.git/*' \) -prune -o \
  -type f \( "${FIND_NAME_ARGS[@]}" \) -print0 2>/dev/null)

# --- egress allowlist ---------------------------------------------------
profile_domains() {
  case "$1" in
    minimal) ;;
    node)    echo "registry.npmjs.org registry.yarnpkg.com" ;;
    git)     echo "github.com codeload.github.com raw.githubusercontent.com objects.githubusercontent.com gist.githubusercontent.com" ;;
    python)  echo "pypi.org files.pythonhosted.org" ;;
    dev)     echo "$(profile_domains node) $(profile_domains git) $(profile_domains python)" ;;
    *)       echo "__UNKNOWN__:$1" ;;
  esac
}

# base: always present. api.anthropic.com is the inference API;
# platform.claude.com is the OAuth token-refresh endpoint - without it the
# seeded credentials die as soon as the access token expires (~hours).
DOMAIN_SET=("api.anthropic.com" "platform.claude.com")
IFS=',' read -ra PROFILES <<< "${CSANDBOX_PROFILE:-minimal}"
for p in "${PROFILES[@]}"; do
  p="$(echo "$p" | tr -d '[:space:]')"
  [ -z "$p" ] && continue
  for d in $(profile_domains "$p"); do
    if [[ "$d" == __UNKNOWN__:* ]]; then
      echo "error: unknown profile '${d#__UNKNOWN__:}' (valid: minimal node git python dev)" >&2
      exit 1
    fi
    DOMAIN_SET+=("$d")
  done
done
if [ -n "${CSANDBOX_EXTRA_DOMAINS:-}" ]; then
  IFS=',' read -ra EXTRA <<< "$CSANDBOX_EXTRA_DOMAINS"
  for d in "${EXTRA[@]}"; do
    d="$(echo "$d" | tr -d '[:space:]')"
    [ -n "$d" ] && DOMAIN_SET+=("$d")
  done
fi
# dedupe, preserving order
ALLOWED_DOMAINS="$(printf '%s\n' "${DOMAIN_SET[@]}" | awk '!seen[$0]++' | paste -sd, -)"
export ALLOWED_DOMAINS

# --- workspace mount mode ------------------------------------------------
WORKSPACE_MOUNT="$ROOT:$ROOT"
MOUNT_NOTE="read-write"
if [ "${CSANDBOX_READONLY:-}" = "1" ]; then
  WORKSPACE_MOUNT="$ROOT:$ROOT:ro"
  MOUNT_NOTE="read-only"
fi

if [ "${CSANDBOX_SHELL:-}" = "1" ]; then
  CMD=(bash)
else
  # By default the agent enters a disposable worktree at session start (see the
  # "Top-level session worktree" block in the seeded CLAUDE.md). --live overrides
  # that with a system-prompt directive, so the agent edits the checked-out tree
  # directly - use it when you want its work to land on your working tree.
  CLAUDE_ENV=(IS_SANDBOX=1)
  [ -n "$CSANDBOX_SUMMARY" ] && CLAUDE_ENV+=("CSANDBOX_SUMMARY=$CSANDBOX_SUMMARY")
  [ -n "$CSANDBOX_MANIFEST" ] && CLAUDE_ENV+=("CSANDBOX_MANIFEST=$CSANDBOX_MANIFEST")
  [ -n "$CSANDBOX_COMMENTS" ] && CLAUDE_ENV+=("CSANDBOX_COMMENTS=$CSANDBOX_COMMENTS")
  # CSANDBOX_SESSION_ID + CSANDBOX_SNAPSHOT are inherited by subagents, so they
  # share this session's frozen snapshot and per-repo worktrees.
  [ -n "$CSANDBOX_SNAPSHOT" ] && CLAUDE_ENV+=("CSANDBOX_SNAPSHOT=$CSANDBOX_SNAPSHOT" "CSANDBOX_SESSION_ID=$SESSION_ID")
  CLAUDE_ARGS=(--dangerously-skip-permissions)
  [ ${#MINT_SESSION_ARGS[@]} -gt 0 ] && CLAUDE_ARGS+=("${MINT_SESSION_ARGS[@]}")
  if [ "$LIVE" = 1 ]; then
    CLAUDE_ENV+=(CSANDBOX_LIVE=1)
    CLAUDE_ARGS+=(--append-system-prompt "This session was launched with csandbox --live: work DIRECTLY in the checked-out working tree on its CURRENT branch, for the whole session. Do NOT create or switch to another branch or git worktree by ANY means - not EnterWorktree, not csbox-enter-repo, and not raw git (git worktree add / git checkout -b / git switch -c) - not at startup, not mid-session, and not to package a deliverable, review, or fix. If you commit, commit on the current branch. The user has deliberately chosen to work live on their current tree; this OVERRIDES all branch/worktree guidance in CLAUDE.md (the Top-level session worktree block, Crossing repos, and any review guidance).")
  fi
  if [ -n "$FINDINGS_DIR" ]; then
    CLAUDE_ENV+=("FINDINGS_DB=/home/node/.findings/findings.db" "FINDINGS_EVENTS=$FINDINGS_EVENTS")
    [ -n "$SESSION_ID" ] && CLAUDE_ENV+=("FINDINGS_SESSION=$SESSION_ID")
    # ephemeral (per-run) guidance - NOT written to the persistent CLAUDE.md, so
    # it never leaks into non --findings runs. Same mechanism as --live above.
    CLAUDE_ARGS+=(--append-system-prompt "An external 'findings' memory (a shared cross-session store) is available this session. Before investigating anything non-trivial, run 'findings recall <terms>' first - a past session may have already worked it out. When you learn something durable that isn't obvious from the code (a mechanism or gotcha, a decision and why, or a fact about the user/environment), record it with 'findings record'. Full usage guide: /opt/findings/skills/findings.md. This is opt-in test tooling - use it alongside your normal workflow.")
  fi
  CMD=(env "${CLAUDE_ENV[@]}" claude "${CLAUDE_ARGS[@]}" "$@")
fi

# --- launch -------------------------------------------------------------
echo "csandbox: mount $ROOT ($MOUNT_NOTE), $SCRUB_COUNT secret file(s) shadowed"
echo "csandbox: egress allowlist -> $ALLOWED_DOMAINS"
[ -n "$LINKER_DIR" ] && echo "csandbox: linker -> $LINKER_DIR (declarative local links wired per-worktree)"
[ -n "$FINDINGS_DIR" ] && echo "csandbox: findings -> $FINDINGS_DIR (external memory at ~/.findings, telemetry on; --no-findings to disable)"
[ "$LIVE" = 1 ] && echo "csandbox: --live -> agent edits the working tree directly (no top-level worktree)"

# dry run: show resolved config and stop before touching docker
if [ "${CSANDBOX_DRYRUN:-}" = "1" ]; then
  echo "csandbox: workdir $PROJECT_DIR"
  for m in "${EXTRA_MOUNTS[@]}"; do [ "$m" = "-v" ] || echo "csandbox: extra mount $m"; done
  echo "csandbox: (dry run, not launching)"
  exit 0
fi

# build images quietly (only rebuilds on change; fast when cached)
compose build --quiet 2>/dev/null || compose build

# (re)create the proxy with the current allowlist (compose recreates it when
# ALLOWED_DOMAINS differs from the running instance)
compose up -d proxy >/dev/null 2>&1
SINCE="$(date -u +%Y-%m-%dT%H:%M:%S)"

# Mark the session RUNNING in the tasks db up front (host-side; the container
# can't reach the db). The review app uses this to show live sessions and to
# refuse a merge/destroy on one. The post-run recorder flips it to ready/
# summary_only on exit; a row stuck at 'running' means the container was killed
# hard. Skipped for shell mode and picker runs (no id yet).
if [ -n "$SESSION_ID" ] && [ "${CSANDBOX_SHELL:-}" != "1" ]; then
  python3 - "$TASKS_DB" "$SESSION_ID" "$PROJECT_DIR" "$NAME" "$SCRATCH_DIR" <<'PY' 2>/dev/null || true
import os, sqlite3, sys, time
db, sid, pdir, name, scratch = sys.argv[1:6]
adir = os.path.join(scratch, 'sessions', sid)
adir = adir if os.path.isdir(adir) else ''
now = int(time.time())
con = sqlite3.connect(db, timeout=10)
try:
    con.execute('PRAGMA busy_timeout=5000')
    con.execute('''CREATE TABLE IF NOT EXISTS sessions (
        session_id TEXT PRIMARY KEY, name TEXT, dir TEXT, branch TEXT, base_sha TEXT,
        head_sha TEXT, status TEXT, summary_path TEXT, artifacts_dir TEXT,
        created_at INTEGER, updated_at INTEGER)''')
    cols = [r[1] for r in con.execute('PRAGMA table_info(sessions)')]
    for c in ('summary_path', 'name', 'artifacts_dir'):
        if c not in cols:
            con.execute('ALTER TABLE sessions ADD COLUMN %s TEXT' % c)
    con.execute('''INSERT INTO sessions
          (session_id, name, dir, status, artifacts_dir, created_at, updated_at)
        VALUES (?,?,?,?,?,?,?)
        ON CONFLICT(session_id) DO UPDATE SET
          status='running', dir=excluded.dir, artifacts_dir=excluded.artifacts_dir,
          name=COALESCE(excluded.name, sessions.name), updated_at=excluded.updated_at''',
        (sid, name or None, pdir, 'running', adir or None, now, now))
    con.commit()
finally:
    con.close()
PY
fi

set +e
compose run --rm \
  -v "$WORKSPACE_MOUNT" \
  -v "$CONFIG_DIR:/home/node/.claude" \
  -v "$SCRATCH_DIR:/home/node/scratch" \
  "${EXTRA_MOUNTS[@]}" \
  -w "$PROJECT_DIR" \
  sandbox \
  "${CMD[@]}"
RC=$?
set -e

# report any hosts blocked during this session so the user knows what to add
BLOCKED="$(compose logs proxy --since "$SINCE" 2>/dev/null \
  | grep -oE 'DENY [^:]+:' | sed 's/DENY //; s/:$//' | sort -u | paste -sd, - || true)"
if [ -n "$BLOCKED" ]; then
  echo "csandbox: blocked egress this session -> $BLOCKED"
  echo "csandbox: to allow, re-run with CSANDBOX_EXTRA_DOMAINS=$BLOCKED (or a profile)"
fi

# --- record this run in the tasks db (host-side) -------------------------
# One row per run for the review UI. Written on the host, not in the container,
# so concurrent sandboxes are just ordinary multi-process SQLite on a local fs
# (busy_timeout absorbs the rare collision). Best-effort: never fail the launch
# over recording. The session's working dir is read from the session file's
# gitBranch transitions in the session log (robust vs decoding the projects/
# folder name), computed on the main checkout so they survive worktree cleanup.
# Also records the summary artifact path and a coarse review status.
if [ "${CSANDBOX_SHELL:-}" != "1" ]; then
  python3 - "$TASKS_DB" "$SESSION_ID" "$PROJECT_DIR" "$CONFIG_DIR/projects" "$SCRATCH_DIR" "$NAME" <<'PY' || true
import glob, json, os, sqlite3, subprocess, sys, time

db, session_id, project_dir, projects_dir, scratch_dir, name = sys.argv[1:7]

def session_file(sid):
    if sid:
        hits = glob.glob(os.path.join(projects_dir, '*', sid + '.jsonl'))
        return hits[0] if hits else None
    files = glob.glob(os.path.join(projects_dir, '*', '*.jsonl'))
    return max(files, key=os.path.getmtime) if files else None

f = session_file(session_id)
if not f:
    sys.exit(0)                       # nothing ran / not found - skip quietly
if not session_id:
    session_id = os.path.basename(f)[:-len('.jsonl')]

# Collect cwd + gitBranch transitions. The session starts in the launch dir on
# the base branch, then EnterWorktree moves it into a worktree on a new branch,
# so the LAST values are the ones that matter (first cwd/branch are just the
# launch state). A trailing ExitWorktree may revert them, but the branch object
# persists, so we diff by branch name on the main checkout below.
cwds = []; branches = []
try:
    with open(f, encoding='utf-8') as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except Exception:
                continue
            if not isinstance(rec, dict):
                continue
            c = rec.get('cwd'); b = rec.get('gitBranch')
            if c and (not cwds or cwds[-1] != c): cwds.append(c)
            if b and (not branches or branches[-1] != b): branches.append(b)
except Exception:
    pass

def git(d, *a):
    try:
        return subprocess.check_output(['git', '-C', d, *a],
                                       stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        return ''

resume_dir  = cwds[-1] if cwds else project_dir       # session home (for --resume)
base_branch = branches[0] if branches else ''
# work branch = the last branch that DIFFERS from the base. The agent is told to
# ExitWorktree when done, which reverts gitBranch back to the base - so
# branches[-1] would equal the base and hide the work done on the worktree
# branch. (A same-branch session with commits and no worktree still looks like
# summary_only here; recording base_sha at launch would fix that - a follow-up.)
_work = [b for b in branches if b != base_branch]
work_branch = _work[-1] if _work else (branches[-1] if branches else '')

# Compute the reviewable branch/diff on the main checkout: branches are shared
# across worktrees, so this works even if the worktree dir is cleaned up. A
# session that never left the base branch (e.g. --live) has no separate branch
# to diff - record head only, leave base empty (a working-tree review).
branch   = work_branch or git(project_dir, 'rev-parse', '--abbrev-ref', 'HEAD')
head_sha = git(project_dir, 'rev-parse', work_branch or 'HEAD')
base_sha = ''
if work_branch and base_branch and work_branch != base_branch:
    base_sha = git(project_dir, 'merge-base', work_branch, base_branch)

# summary artifact (absent if the agent wrote none, or a --continue run that had
# no CSANDBOX_SUMMARY); recorded as the host path the review UI reads
summary_path = os.path.join(scratch_dir, 'sessions', session_id, 'summary.md')
if not os.path.exists(summary_path):
    summary_path = ''

# The post-checkout hook records each worktree's exact fork point in the
# manifest; prefer it for the work branch's base - more accurate than merge-base,
# and the foundation for the subagent tree (later steps read the whole manifest).
manifest = os.path.join(scratch_dir, 'sessions', session_id, 'worktrees.jsonl')
if work_branch and os.path.exists(manifest):
    try:
        with open(manifest, encoding='utf-8') as fh:
            for line in fh:
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                if isinstance(e, dict) and e.get('branch') == work_branch and e.get('fork_sha'):
                    base_sha = e['fork_sha']
    except Exception:
        pass

# coarse review status: a diff to review, or none. 'blocked' is reserved for the
# transcript prompt-scan follow-up (a session that stalled on a permission wall).
status = 'ready' if base_sha else 'summary_only'

# the session's scratch dir - where csreview finds this session's per-worktree
# manifest (worktrees.jsonl -> the subagent branches to review) and the review
# comment log (comments.jsonl). One pointer; the rest are siblings.
artifacts_dir = os.path.join(scratch_dir, 'sessions', session_id)
if not os.path.isdir(artifacts_dir):
    artifacts_dir = ''

# display label: the --name if given, else the branch slug (already semi-readable)
if not name:
    name = branch[len('worktree-'):] if branch.startswith('worktree-') else (branch or session_id[:8])

now = int(time.time())
con = sqlite3.connect(db, timeout=10)
try:
    con.execute('PRAGMA busy_timeout=5000')
    con.execute('''CREATE TABLE IF NOT EXISTS sessions (
        session_id   TEXT PRIMARY KEY,
        name         TEXT,
        dir          TEXT,
        branch       TEXT,
        base_sha     TEXT,
        head_sha     TEXT,
        status        TEXT,
        summary_path  TEXT,
        artifacts_dir TEXT,
        created_at    INTEGER,
        updated_at    INTEGER
    )''')
    # migrate dbs created before these columns existed
    cols = [r[1] for r in con.execute('PRAGMA table_info(sessions)')]
    if 'summary_path' not in cols:
        con.execute('ALTER TABLE sessions ADD COLUMN summary_path TEXT')
    if 'name' not in cols:
        con.execute('ALTER TABLE sessions ADD COLUMN name TEXT')
    if 'artifacts_dir' not in cols:
        con.execute('ALTER TABLE sessions ADD COLUMN artifacts_dir TEXT')
    con.execute('''INSERT INTO sessions
          (session_id, name, dir, branch, base_sha, head_sha, status, summary_path,
           artifacts_dir, created_at, updated_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?)
        ON CONFLICT(session_id) DO UPDATE SET
          name=excluded.name, dir=excluded.dir, branch=excluded.branch,
          base_sha=excluded.base_sha, head_sha=excluded.head_sha,
          status=excluded.status, summary_path=excluded.summary_path,
          artifacts_dir=excluded.artifacts_dir, updated_at=excluded.updated_at''',
        (session_id, name, resume_dir, branch, base_sha, head_sha, status,
         summary_path, artifacts_dir, now, now))
    con.commit()
finally:
    con.close()
sys.stderr.write("csandbox: recorded session %s (branch=%s, status=%s) in tasks db\n"
                 % (session_id[:8], branch or '-', status))
PY
fi

exit $RC
