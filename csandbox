# Note: the guard below checks for a phrase unique to the updated text (not
# just the heading), so a host whose CLAUDE.md was seeded before this check
# existed gets the fix appended too - at the cost of a duplicate heading on
# that one host, which is a fine trade given what skipping the check cost
# (see below).
# Sections whose text has changed since an earlier seeding: drop the stale
# version (identified by a phrase only the old text had) so the guards below
# re-append the current one. A section runs from its "# heading" to the next
# "# " line.
python3 - "$CONFIG_DIR/CLAUDE.md" "$EDIT_GATE" <<'PY'
import re, sys
p, edit_gate = sys.argv[1], sys.argv[2]
try:
    s = open(p).read()
except FileNotFoundError:
    sys.exit()
def drop(s, heading, stale):
    m = re.search(r'(?ms)^# ' + re.escape(heading) + r'\n.*?(?=^# |\Z)', s)
    if m and stale in m.group(0):
        s = s[:m.start()].rstrip('\n') + '\n' + s[m.end():]
    return s
s = drop(s, 'Top-level session worktree', 'at the start of every session in a git repo, call `EnterWorktree`')
s = drop(s, 'Parallel worktree subagents', "nested under the\ntop-level session's own worktree")
s = drop(s, 'Session output', 'COMMIT your work on the worktree branch before finishing')
if edit_gate != '1':
    s = drop(s, 'Edit gate', 'edit gate hook')   # section only belongs when the gate is on
open(p, 'w').write(s)
PY
